---
import BaseLayout from '../layouts/BaseLayout.astro';
import CvContent from '../components/CvContent.astro';
import { cvStructuredData } from '../lib/structuredData';
---

<BaseLayout
	title="CV"
	description="Readable CV for Carlos Olivo with a downloadable PDF."
	canonicalPath="/cv/"
	alternateLocales={[
		{ lang: 'en', href: '/cv/' },
		{ lang: 'es', href: '/es/cv/' },
		{ lang: 'x-default', href: '/cv/' },
	]}
	structuredData={cvStructuredData}
>
	<CvContent locale="en" />
</BaseLayout>
