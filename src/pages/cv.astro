---
import BaseLayout from '../layouts/BaseLayout.astro';
import CvContent from '../components/CvContent.astro';
import { cvStructuredData } from '../lib/structuredData';
---

<BaseLayout
	title="Carlos Olivo CV"
	description="Carlos Olivo CV: senior software engineer with experience in backend systems, SaaS platforms, travel-tech integrations, cloud infrastructure, and AI automation."
	imageAlt="Carlos Olivo CV, Senior Software Engineer"
	canonicalPath="/cv/"
	alternateLocales={[
		{ lang: 'en', href: '/cv/' },
		{ lang: 'es', href: '/es/cv/' },
		{ lang: 'x-default', href: '/cv/' },
	]}
	structuredData={cvStructuredData}
>
	<CvContent locale="en" />
</BaseLayout>
