---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../sections/Hero.astro';
import CaseStudies from '../../sections/CaseStudies.astro';
import Experience from '../../sections/Experience.astro';
import TechnicalFocus from '../../sections/TechnicalFocus.astro';
import Contact from '../../sections/Contact.astro';
import HomeLanguage from '../../components/HomeLanguage.astro';
import { spanishHomeStructuredData } from '../../lib/structuredData';

const description =
	'Ingeniero de software senior que construye sistemas backend que ahorran tiempo a los equipos y mantienen rápidos y confiables los flujos que generan ingresos en productos travel-tech, SaaS y educación.';
---

<BaseLayout
	title="Senior Software Engineer"
	description={description}
	lang="es"
	imageAlt="Carlos Olivo, ingeniero senior de software especializado en backend, SaaS, travel-tech y automatización con IA"
	canonicalPath="/es/"
	alternateLocales={[
		{ lang: 'en', href: '/' },
		{ lang: 'es', href: '/es/' },
		{ lang: 'x-default', href: '/' },
	]}
	structuredData={spanishHomeStructuredData}
>
	<Hero locale="es" />
	<CaseStudies locale="es" />
	<Experience locale="es" />
	<TechnicalFocus locale="es" />
	<Contact locale="es" />
	<HomeLanguage locale="es" />
</BaseLayout>
