---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../sections/Hero.astro';
import Journey from '../../sections/Journey.astro';
import CaseStudies from '../../sections/CaseStudies.astro';
import Experience from '../../sections/Experience.astro';
import Contact from '../../sections/Contact.astro';
import HomeLanguage from '../../components/HomeLanguage.astro';
import { spanishHomeStructuredData } from '../../lib/structuredData';

const description =
	'Ingeniero de software en Georgia, EE. UU., que convierte problemas concretos en productos simples y efectivos: backend de oficio, de punta a punta cuando hace falta y con IA como aliada.';
---

<BaseLayout
	title="Senior Software Engineer"
	description={description}
	lang="es"
	imageAlt="Carlos Olivo, ingeniero de software senior: backend, producto de punta a punta y desarrollo con IA"
	canonicalPath="/es/"
	alternateLocales={[
		{ lang: 'en', href: '/' },
		{ lang: 'es', href: '/es/' },
		{ lang: 'x-default', href: '/' },
	]}
	structuredData={spanishHomeStructuredData}
>
	<Hero locale="es" />
	<Journey locale="es" />
	<CaseStudies locale="es" />
	<Experience locale="es" />
	<Contact locale="es" />
	<HomeLanguage locale="es" />
</BaseLayout>
