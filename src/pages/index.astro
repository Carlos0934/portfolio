---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import CaseStudies from '../sections/CaseStudies.astro';
import Experience from '../sections/Experience.astro';
import TechnicalFocus from '../sections/TechnicalFocus.astro';
import Contact from '../sections/Contact.astro';
import HomeLanguage from '../components/HomeLanguage.astro';
import { homeStructuredData } from '../lib/structuredData';

const description =
	'Senior Software Engineer building backend systems that save teams time and keep revenue-critical flows fast and reliable across travel-tech, SaaS, and education products.';
---

<BaseLayout
	title="Senior Software Engineer"
	description={description}
	imageAlt="Carlos Olivo, Senior Software Engineer specializing in backend systems, SaaS architecture, travel-tech integrations, and AI workflow automation"
	canonicalPath="/"
	alternateLocales={[
		{ lang: 'en', href: '/' },
		{ lang: 'es', href: '/es/' },
		{ lang: 'x-default', href: '/' },
	]}
	structuredData={homeStructuredData}
>
	<Hero />
	<CaseStudies />
	<Experience />
	<TechnicalFocus />
	<Contact />
	<HomeLanguage locale="auto" />
</BaseLayout>
