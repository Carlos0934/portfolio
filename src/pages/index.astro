---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import Journey from '../sections/Journey.astro';
import CaseStudies from '../sections/CaseStudies.astro';
import Experience from '../sections/Experience.astro';
import Contact from '../sections/Contact.astro';
import HomeLanguage from '../components/HomeLanguage.astro';
import { homeStructuredData } from '../lib/structuredData';
import { SITE_DESCRIPTION } from '../consts';

---

<BaseLayout
	title="Senior Software Engineer"
	description={SITE_DESCRIPTION}
	imageAlt="Carlos Olivo, Senior Software Engineer: backend, end-to-end products, and AI-assisted development"
	canonicalPath="/"
	alternateLocales={[
		{ lang: 'en', href: '/' },
		{ lang: 'es', href: '/es/' },
		{ lang: 'x-default', href: '/' },
	]}
	structuredData={homeStructuredData}
>
	<Hero />
	<Journey />
	<CaseStudies />
	<Experience />
	<Contact />
	<HomeLanguage locale="auto" />
</BaseLayout>
