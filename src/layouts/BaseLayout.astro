---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	imageAlt?: string;
	canonicalPath?: string;
	alternateLocales?: Array<{ lang: string; href: string }>;
	structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { title, description, lang = 'en', imageAlt, canonicalPath, alternateLocales = [], structuredData } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			lang={lang}
			imageAlt={imageAlt}
			canonicalPath={canonicalPath}
			alternateLocales={alternateLocales}
			structuredData={structuredData}
		/>
	</head>
	<body class="bg-background text-text-primary antialiased">
		<!-- Skip Navigation Link -->
		<a href="#main-content" class="skip-nav">Skip to main content</a>
		
		<!-- Mobile Header with Logo -->
		<Header lang={lang} />
		
		<main id="main-content" tabindex="-1" class="min-h-screen">
			<slot />
		</main>
		
		<Footer lang={lang} />
	</body>
</html>
