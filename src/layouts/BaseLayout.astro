---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	imageAlt?: string;
	canonicalPath?: string;
	alternateLocales?: Array<{ lang: string; href: string }>;
	structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { title, description, lang = 'en', imageAlt, canonicalPath, alternateLocales = [], structuredData } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			lang={lang}
			imageAlt={imageAlt}
			canonicalPath={canonicalPath}
			alternateLocales={alternateLocales}
			structuredData={structuredData}
		/>
	</head>
	<body class="bg-background text-text-primary antialiased">
		<!-- Skip Navigation Link -->
		<a href="#main-content" class="skip-nav">Skip to main content</a>
		
		<!-- Mobile Header with Logo -->
		<Header lang={lang} />
		
		<main id="main-content" tabindex="-1" class="min-h-screen">
			<slot />
		</main>
		
		<Footer lang={lang} />
		<script>
			function initObservedReveals() {
				const revealGroups = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
				if (!revealGroups.length) return;

				const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				const supportsObserver = 'IntersectionObserver' in window;

				revealGroups.forEach((group) => {
					if (group.dataset.revealInitialized === 'true') return;
					group.dataset.revealInitialized = 'true';

					const items = Array.from(group.querySelectorAll<HTMLElement>('[data-reveal-item]'));
					if (!items.length) return;

					if (prefersReducedMotion || !supportsObserver) {
						group.classList.add('is-visible');
						items.forEach((item) => item.classList.add('is-visible'));
						return;
					}

					group.classList.add('js-reveal-active');

					if (group.dataset.reveal === 'items') {
						const observer = new IntersectionObserver(
							(entries) => {
								entries.forEach((entry) => {
									if (!entry.isIntersecting) return;
									entry.target.classList.add('is-visible');
									observer.unobserve(entry.target);
								});
							},
							{ rootMargin: '0px 0px -8% 0px', threshold: 0.18 }
						);

						items.forEach((item) => {
							if (item.getBoundingClientRect().top < window.innerHeight * 0.92) {
								item.classList.add('is-visible');
								return;
							}

							observer.observe(item);
						});
						return;
					}

					const observer = new IntersectionObserver(
						(entries) => {
							entries.forEach((entry) => {
								if (!entry.isIntersecting) return;
								group.classList.add('is-visible');
								observer.disconnect();
							});
						},
						{ rootMargin: '0px 0px -10% 0px', threshold: 0.18 }
					);

					if (group.getBoundingClientRect().top < window.innerHeight * 0.92) {
						group.classList.add('is-visible');
						return;
					}

					observer.observe(group);
				});
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initObservedReveals);
			} else {
				initObservedReveals();
			}

			document.addEventListener('astro:after-swap', initObservedReveals);
		</script>
	</body>
</html>
