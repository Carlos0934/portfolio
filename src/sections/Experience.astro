---
import { getCollection, render } from 'astro:content';
interface Props {
	locale?: 'en' | 'es';
}
const { locale = 'en' } = Astro.props;
const isSpanish = locale === 'es';
const experienceTranslations: Record<string, { role: string; location: string; body: string }> = {
	'pricetravel-holding': {
		role: 'Backend Developer — Conectividad hotelera y cotización',
		location: 'Remoto (US)',
		body: 'Responsable de la conectividad con proveedores hoteleros y de las rutas de datos detrás del motor de cotización, trabajando con el equipo de cotización en precisión y tiempo de respuesta.',
	},
	listoapp: {
		role: 'Backend Developer — Plataformas SaaS y cloud',
		location: 'Remoto (US)',
		body: 'Entrega backend y cloud para los productos SaaS de la empresa y plataformas de clientes, desde el diseño de APIs hasta el rendimiento serverless y CI/CD.',
	},
	drimo: {
		role: 'Software Developer',
		location: 'Remoto',
		body: 'Migré el sitio web y el blog de la empresa a un stack más rápido y amigable con SEO mediante una migración automatizada, y mantuve APIs serverless confiables y eficientes en costo mientras entregaba funcionalidades web y móviles.',
	},
};

const experienceEntries = await getCollection('experience');
const experiencesWithContent = await Promise.all(
	experienceEntries.map(async (entry) => {
		const { Content } = await render(entry);
		return { ...entry, Content };
	})
);

const sortedExperiences = experiencesWithContent.sort((a, b) => a.data.order - b.data.order);
---

<section id="experience" class="experience-section border-b border-border bg-surface-container-low py-16 section-reveal md:py-24">
	<div class="mx-auto max-w-6xl px-4 lg:px-8">
		<p class="section-label mb-4" data-i18n="experience.eyebrow">
			{isSpanish ? 'Trayectoria' : 'Career path'}
		</p>
		<h2 class="section-title mb-10" data-i18n="experience.title">
			{isSpanish ? 'Experiencia' : 'Experience'}
		</h2>

		<div class="experience-list max-w-3xl space-y-10" data-experience-list>
			{sortedExperiences.map((item, index) => (
				<article class="experience-entry relative pl-6" style={`--experience-delay: ${index * 90}ms;`}>
					<div class="experience-marker" aria-hidden="true">
						<div class="experience-line"></div>
						<div class="experience-dot"></div>
					</div>

					<div class="experience-entry__header mb-1.5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
						<h3 class="experience-entry__title text-lg font-semibold tracking-tight text-text-primary" data-i18n={`experience.${item.id}.role`}>
							{isSpanish ? experienceTranslations[item.id]?.role ?? item.data.role : item.data.role}
						</h3>
						<span class="experience-entry__company text-text-muted">
							@ {item.data.company}
						</span>
					</div>

					<div class="experience-entry__meta mb-3 text-sm text-text-muted">
						{item.data.dateRange}
						{item.data.location && <span> · <span data-i18n={`experience.${item.id}.location`}>{isSpanish ? experienceTranslations[item.id]?.location ?? item.data.location : item.data.location}</span></span>}
					</div>

					<div class="experience-entry__body text-readable" data-i18n={`experience.${item.id}.body`}>
						{isSpanish ? <p>{experienceTranslations[item.id]?.body}</p> : <item.Content />}
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<script>
	function getExperienceThreshold() {
		const width = window.innerWidth;
		if (width < 640) return 0.18;
		if (width < 1024) return 0.24;
		return 0.3;
	}

	function isAlreadyVisible(element: HTMLElement) {
		const rect = element.getBoundingClientRect();
		return rect.top < window.innerHeight * 0.92;
	}

	function updateExperienceMarkers() {
		const section = document.getElementById('experience');
		const list = section?.querySelector('[data-experience-list]');
		if (!section || !list) return;

		const items = Array.from(list.querySelectorAll('.experience-entry')) as HTMLElement[];
		items.forEach((item) => {
			const marker = item.querySelector('.experience-marker') as HTMLElement | null;
			if (!marker) return;
			const travel = Math.max(marker.offsetHeight - 8, 0);
			item.style.setProperty('--experience-marker-travel', `${travel}px`);
		});
	}

	function initExperienceAppear() {
		const section = document.getElementById('experience');
		const list = section?.querySelector('[data-experience-list]');
		if (!section || !list) return;

		// Guard against double-initialization (e.g. astro:after-swap)
		if (section.dataset.revealInitialized === 'true') return;
		section.dataset.revealInitialized = 'true';

		const items = Array.from(list.querySelectorAll('.experience-entry')) as HTMLElement[];
		if (!items.length) return;

		items.forEach((item) => {
			const marker = item.querySelector('.experience-marker') as HTMLElement | null;
			if (!marker) return;

			const travel = Math.max(marker.offsetHeight - 8, 0);
			item.style.setProperty('--experience-marker-travel', `${travel}px`);
		});

		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (prefersReducedMotion || !('IntersectionObserver' in window)) {
			section.classList.add('is-visible');
			items.forEach((item) => item.classList.add('is-visible'));
			return;
		}

		section.classList.add('js-reveal-active');

		// If section is already in viewport, reveal immediately
		if (isAlreadyVisible(section)) {
			section.classList.add('is-visible');
			items.forEach((item) => item.classList.add('is-visible'));
			return;
		}

		const threshold = getExperienceThreshold();
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;

					section.classList.add('is-visible');
					items.forEach((item) => item.classList.add('is-visible'));
					observer.disconnect();
				});
			},
			{
				threshold,
				rootMargin: '0px 0px -6% 0px',
			}
		);

		observer.observe(section);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initExperienceAppear);
	} else {
		initExperienceAppear();
	}

	document.addEventListener('astro:after-swap', initExperienceAppear);
	window.addEventListener('resize', updateExperienceMarkers);
</script>

<style>
	.experience-entry {
		opacity: 1;
		transform: translate3d(0, 0, 0);
		transition:
			opacity 420ms var(--fx-easing-out),
			transform 500ms var(--fx-easing-out),
			border-color 220ms var(--fx-easing-out);
	}

	.js-reveal-active .experience-entry {
		opacity: 0;
		transform: translate3d(0, 16px, 0);
	}

	.experience-marker {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 10px;
	}

	.experience-line {
		position: absolute;
		left: 50%;
		top: 4px;
		bottom: 0;
		width: 2px;
		transform: translateX(-50%);
		overflow: hidden;
	}

	.experience-line::before {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--color-border);
		transform-origin: bottom center;
		transform: scaleY(0);
		opacity: 0;
		transition:
			transform 760ms var(--fx-easing-out),
			opacity 260ms var(--fx-easing-out);
		transition-delay: var(--experience-delay, 0ms);
	}

	.experience-dot {
		position: absolute;
		left: 50%;
		bottom: 0;
		z-index: 1;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-primary);
		border: 1px solid var(--color-primary);
		opacity: 0;
		transform: translateX(-50%) translateY(0) scale(0.45);
		transition:
			opacity 320ms var(--fx-easing-out),
			transform 900ms var(--fx-easing-out);
		transition-delay: var(--experience-delay, 0ms);
	}

	.experience-entry__title,
	.experience-entry__company,
	.experience-entry__meta,
	.experience-entry__body {
		opacity: 1;
		transform: translate3d(0, 0, 0);
	}

	.js-reveal-active .experience-entry__title,
	.js-reveal-active .experience-entry__company,
	.js-reveal-active .experience-entry__meta,
	.js-reveal-active .experience-entry__body {
		opacity: 0;
		transform: translate3d(0, 12px, 0);
	}

	.experience-entry.is-visible,
	.js-reveal-active .experience-entry.is-visible {
		opacity: 1;
		transform: translate3d(0, 0, 0);
		transition-delay: var(--experience-delay, 0ms);
	}

	.experience-entry.is-visible .experience-line::before {
		transform: scaleY(1);
		opacity: 1;
	}

	.experience-entry.is-visible .experience-dot {
		opacity: 1;
		transform: translateX(-50%) translateY(calc(-1 * var(--experience-marker-travel, 40px))) scale(1);

	}

	.experience-entry.is-visible .experience-entry__title,
	.experience-entry.is-visible .experience-entry__company,
	.experience-entry.is-visible .experience-entry__meta,
	.experience-entry.is-visible .experience-entry__body,
	.js-reveal-active .experience-entry.is-visible .experience-entry__title,
	.js-reveal-active .experience-entry.is-visible .experience-entry__company,
	.js-reveal-active .experience-entry.is-visible .experience-entry__meta,
	.js-reveal-active .experience-entry.is-visible .experience-entry__body {
		opacity: 1;
		transform: translate3d(0, 0, 0);
		transition-property: opacity, transform;
		transition-duration: 420ms, 520ms;
		transition-timing-function: var(--fx-easing-out), var(--fx-easing-out);
	}

	.experience-entry.is-visible .experience-entry__title,
	.experience-entry.is-visible .experience-entry__company {
		transition-delay: calc(var(--experience-delay, 0ms) + 90ms);
	}

	.experience-entry.is-visible .experience-entry__meta {
		transition-delay: calc(var(--experience-delay, 0ms) + 190ms);
	}

	.experience-entry.is-visible .experience-entry__body {
		transition-delay: calc(var(--experience-delay, 0ms) + 310ms);
	}

	@media (prefers-reduced-motion: reduce) {
		.experience-entry,
		.js-reveal-active .experience-entry,
		.experience-line::before,
		.experience-dot,
		.experience-entry__title,
		.experience-entry__company,
		.experience-entry__meta,
		.experience-entry__body,
		.js-reveal-active .experience-entry__title,
		.js-reveal-active .experience-entry__company,
		.js-reveal-active .experience-entry__meta,
		.js-reveal-active .experience-entry__body {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}
</style>
