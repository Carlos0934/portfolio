---
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../lib/i18n';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const experiences = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);

// Numbers carry the improvement, so they get emphasis. HomeLanguage repeats this for client-side translation.
const emphasizeNumbers = (text: string) =>
	text
		.split(/(\d[\d.,]*%?)/)
		.map((part, index) => ({ text: part, strong: index % 2 === 1 }))
		.filter((part) => part.text);
---

<section id="experience" class="experience" data-reveal="items">
	<div class="mx-auto max-w-6xl px-4 lg:px-8">
		<p class="section-label" data-i18n="experience.eyebrow">{t('experience.eyebrow', 'Experience')}</p>
		<h2 class="section-title mt-4" data-i18n="experience.title">{t('experience.title', "Where I've worked, and what I improved.")}</h2>

		<ol class="timeline" role="list">
			{experiences.map((item) => {
				const key = `experience.${item.id}`;
				return (
					<li class:list={['job', { 'job--current': item.data.current }]} data-reveal-item>
						<div class="job__when">
							<span data-i18n={`${key}.date`}>{t(`${key}.date`, item.data.dateRange)}</span>
							{item.data.location && <span class="job__where" data-i18n={`${key}.location`}>{t(`${key}.location`, item.data.location)}</span>}
						</div>

						<div class="job__body">
							<h3 class="job__title">
								{item.data.url ? (
									<a href={item.data.url} target="_blank" rel="noopener noreferrer">{item.data.company}</a>
								) : (
									item.data.company
								)}{' '}
								<span class="job__role">
									· <span data-i18n={`${key}.role`}>{t(`${key}.role`, item.data.role)}</span>
								</span>
							</h3>
							{item.body && <p class="job__summary" data-i18n={`${key}.body`}>{t(`${key}.body`, item.body.trim())}</p>}

							{item.data.highlights && item.data.highlights.length > 0 && (
								<div class="job__wins">
									<p class="job__wins-label" data-i18n="experience.highlights">{t('experience.highlights', 'What I improved')}</p>
									<ul role="list">
										{item.data.highlights.map((highlight, index) => (
											<li>
												<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
													<path d="M5 12.5 10 17l9-10" />
												</svg>
												<span data-i18n={`${key}.highlight.${index}`} data-i18n-emphasis>
													{emphasizeNumbers(t(`${key}.highlight.${index}`, highlight)).map((part) =>
														part.strong ? <strong>{part.text}</strong> : part.text
													)}
												</span>
											</li>
										))}
									</ul>
								</div>
							)}

							{item.data.stack && <p class="job__stack">{item.data.stack}</p>}
						</div>
					</li>
				);
			})}
		</ol>
	</div>
</section>

<style>
	.experience {
		padding: 5rem 0;
		border-block: 1px solid var(--color-border);
		background: var(--color-surface-container-lowest);
	}

	.timeline {
		position: relative;
		margin: 3rem 0 0;
		padding: 0;
		list-style: none;
	}

	.job {
		position: relative;
		display: grid;
		gap: 0.5rem;
		padding: 0 0 2.75rem 1.5rem;
	}

	/* Rail and dot */
	.job::before {
		content: "";
		position: absolute;
		left: 0.25rem;
		top: 0.5rem;
		bottom: -0.5rem;
		width: 1px;
		background: var(--color-border);
	}

	.job:last-child::before {
		bottom: auto;
		height: 1.25rem;
	}

	.job::after {
		content: "";
		position: absolute;
		left: 0;
		top: 0.4rem;
		width: 9px;
		height: 9px;
		border: 1.5px solid var(--color-primary);
		border-radius: 9999px;
		background: var(--color-surface-container-lowest);
	}

	.job--current::after {
		background: var(--color-primary);
	}

	.job__when {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.75rem;
		font-size: 0.88rem;
		color: var(--color-text-secondary);
	}

	.job__where {
		font-size: 0.82rem;
		color: var(--color-text-muted);
	}

	.job__title {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.job__title a {
		color: inherit;
		text-decoration: none;
	}

	.job__title a:hover,
	.job__title a:focus-visible {
		color: var(--color-primary);
	}

	.job__role {
		font-weight: 400;
		color: var(--color-text-muted);
	}

	.job__summary {
		max-width: 42rem;
		margin: 0.5rem 0 0;
		font-size: 0.98rem;
		line-height: 1.7;
		color: var(--color-text-secondary);
	}

	/* Improvements: the part of each role worth scanning first */
	.job__wins {
		max-width: 42rem;
		margin-top: 1rem;
		padding: 1rem 1.15rem;
		border: 1px solid var(--color-border);
		border-left: 3px solid var(--color-primary);
		border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
		background: var(--color-primary-container);
	}

	.job__wins-label {
		margin: 0 0 0.6rem;
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-primary);
	}

	.job__wins ul {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.job__wins li {
		display: grid;
		grid-template-columns: 1rem 1fr;
		gap: 0.6rem;
		font-size: 0.94rem;
		line-height: 1.55;
		color: var(--color-text-primary);
	}

	.job__wins svg {
		width: 1rem;
		height: 1rem;
		margin-top: 0.2rem;
		color: var(--color-primary);
	}

	.job__wins :global(strong) {
		font-weight: 600;
		color: var(--color-primary);
	}

	.job__stack {
		margin: 0.85rem 0 0;
		font-size: 0.82rem;
		color: var(--color-text-muted);
	}

	@media (min-width: 48rem) {
		.experience {
			padding: 7rem 0;
		}

		.job {
			grid-template-columns: 11rem 1fr;
			gap: 3rem;
			padding-left: 0;
		}

		.job::before {
			left: 12.5rem;
		}

		.job::after {
			left: calc(12.5rem - 4px);
		}

		.job__when {
			flex-direction: column;
			gap: 0.2rem;
		}
	}
</style>
