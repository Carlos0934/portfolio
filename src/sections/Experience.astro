---
import { getCollection, render } from 'astro:content';

const experienceEntries = await getCollection('experience');
const experiencesWithContent = await Promise.all(
	experienceEntries.map(async (entry) => {
		const { Content } = await render(entry);
		return { ...entry, Content };
	})
);
const sortedExperiences = experiencesWithContent.sort((a, b) => a.data.order - b.data.order);
---

<section id="experience" class="border-b border-border bg-surface-alt py-16 section-reveal">
	<div class="mx-auto max-w-4xl px-4">
		<h2 class="mb-8 text-2xl font-bold tracking-tight text-text-primary md:text-3xl">
			Experience
		</h2>
		<div class="space-y-8">
			{sortedExperiences.map((item) => (
				<article class="relative border-l-2 border-border pl-6">
					<div class="absolute left-0 top-0 h-2 w-2 -translate-x-[5px] rounded-full bg-primary" aria-hidden="true" />
					<div class="mb-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
						<h3 class="text-lg font-semibold text-text-primary">
							{item.data.role}
						</h3>
						<span class="text-text-muted">
							@ {item.data.company}
						</span>
					</div>
					<div class="mb-3 font-mono text-sm text-text-muted">
						{item.data.dateRange}
						{item.data.location && <span> · {item.data.location}</span>}
					</div>
					<div class="prose prose-invert max-w-none text-sm text-text-secondary">
						<item.Content />
					</div>
				</article>
			))}
		</div>
	</div>
</section>