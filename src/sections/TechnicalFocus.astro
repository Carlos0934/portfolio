---
import { getCollection } from 'astro:content';
interface Props {
	locale?: 'en' | 'es';
}
const { locale = 'en' } = Astro.props;
const isSpanish = locale === 'es';

const sectionOrder = ['system-integrations', 'cloud-infrastructure', 'ai-automation'] as const;
type Category = (typeof sectionOrder)[number];

const spanishAreas: Record<Category, { title: string; summary: string }> = {
	'system-integrations': {
		title: 'Conectar los sistemas de los que depende un negocio',
		summary: 'Productos, proveedores y socios comparten datos de forma confiable, sin recaptura manual ni registros desincronizados.',
	},
	'cloud-infrastructure': {
		title: 'Hacer rápidos y confiables los flujos críticos',
		summary: 'Los flujos que generan ingresos responden más rápido, fallan menos y se despliegan de forma automatizada.',
	},
	'ai-automation': {
		title: 'Convertir trabajo repetitivo en minutos',
		summary: 'Automatización e IA que eliminan pasos manuales, mientras las personas siguen a cargo de las decisiones importantes.',
	},
};

const techEntries = await getCollection('technicalFocus');
const areas = sectionOrder
	.map((category) => {
		const entry = techEntries.find((item) => item.data.category === category);
		if (!entry) return null;
		const english = {
			title: entry.data.title,
			summary: (entry.body ?? '').trim(),
		};
		return { category, ...(isSpanish ? spanishAreas[category] : english) };
	})
	.filter((item): item is NonNullable<typeof item> => item !== null);
---

<section id="technical-focus" class="border-b border-border bg-background py-16 md:py-24" data-reveal="items">
	<div class="mx-auto max-w-6xl px-4 lg:px-8">
		<div class="mb-10 max-w-3xl md:mb-14" data-reveal-item>
			<p class="section-label mb-4" data-i18n="technical.eyebrow">
				{isSpanish ? 'Cómo ayudo' : 'How I help'}
			</p>
			<h2 class="section-title" data-i18n="technical.title">
				{isSpanish ? 'Tecnología al servicio del resultado.' : 'Technology in service of the outcome.'}
			</h2>
		</div>

		<ul class="help-grid" role="list">
			{areas.map((area, index) => (
				<li class="help-card" data-reveal-item style={`--reveal-delay: ${index * 70}ms;`}>
					<h3 class="help-card__title" data-i18n={`technical.${area.category}.title`}>{area.title}</h3>
					<p class="help-card__summary" data-i18n={`technical.${area.category}.summary`}>{area.summary}</p>
				</li>
			))}
		</ul>
	</div>
</section>

<style>
	.help-grid {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.help-card {
		display: flex;
		flex-direction: column;
		padding: 1.75rem;
		border-radius: var(--radius-container);
		background: var(--color-surface-container-lowest);
		border: 1px solid var(--color-border);
	}

	.help-card__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.01em;
		color: var(--color-text-primary);
		text-wrap: balance;
	}

	.help-card__summary {
		margin: 0.85rem 0 0;
		font-size: 1rem;
		line-height: 1.65;
		color: var(--color-text-secondary);
	}

	@media (min-width: 64rem) {
		.help-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.25rem;
		}
	}
</style>
