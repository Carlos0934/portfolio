---
import { getCollection, render } from 'astro:content';
interface Props {
	locale?: 'en' | 'es';
}
const { locale = 'en' } = Astro.props;
const isSpanish = locale === 'es';

type FocusItem = {
	label: string;
	value: string;
};

type FocusMeta = {
	eyebrow: string;
	signal: string;
	tags: string[];
};

type FocusCardGroup = {
	items: FocusItem[];
};

const techEntries = await getCollection('technicalFocus');
const techEntriesWithContent = await Promise.all(
	techEntries.map(async (entry) => {
		const { Content } = await render(entry);
		return { ...entry, Content };
	})
);

const sectionTitle = 'Technical Focus';
const sectionDescription =
	'Backend engineering, platform delivery, and integration work — organized by capability area.';
const localizedSectionTitle = isSpanish ? 'Foco técnico' : sectionTitle;
const localizedSectionDescription = isSpanish
	? 'Ingeniería backend, entrega de plataforma e integraciones, organizadas por área de capacidad.'
	: sectionDescription;

const sectionOrder = ['cloud-infrastructure', 'ai-automation', 'system-integrations'] as const;

const focusMeta: Record<(typeof sectionOrder)[number], FocusMeta> = {
	'cloud-infrastructure': {
		eyebrow: 'Cloud Delivery',
		signal: 'AWS-based backends tuned for deployment speed, reliability, and lower-latency workloads.',
		tags: ['AWS', 'Serverless', 'GitHub Actions'],
	},
	'ai-automation': {
		eyebrow: 'Full-Stack Systems',
		signal: 'Product and platform work across JavaScript/TypeScript, .NET, and Go with maintainable service boundaries.',
		tags: ['TypeScript', '.NET 8', 'Go'],
	},
	'system-integrations': {
		eyebrow: 'Provider Connectivity',
		signal: 'Integration layers built for hotel providers, quoting flows, and event-driven service coordination.',
		tags: ['Travel Tech', 'GraphQL', 'Event-Driven'],
	},
};
const spanishFocusMeta: Record<(typeof sectionOrder)[number], Partial<FocusMeta> & { title: string; summary: string; items: FocusItem[] }> = {
	'cloud-infrastructure': {
		eyebrow: 'Entrega cloud',
		title: 'Infraestructura cloud',
		summary: 'Construcción y operación de plataformas SaaS sobre AWS con automatización, ajuste de rendimiento y disciplina de entrega.',
		signal: 'Backends sobre AWS optimizados para velocidad de despliegue, confiabilidad y cargas de menor latencia.',
		items: [
			{ label: 'Cloud e infraestructura', value: 'AWS (Lambda, SNS, EventBridge, DAX, S3), Docker, GitHub Actions' },
			{ label: 'Optimización de plataforma', value: 'Reducción de cold starts en Lambda, despliegues automatizados y background workers para cargas de producción' },
		],
	},
	'ai-automation': {
		eyebrow: 'Sistemas full-stack',
		title: 'Entrega full-stack',
		summary: 'Entrega de sistemas de producto y plataforma entre backend, frontend y capas de servicio con fuerte énfasis en mantenibilidad.',
		signal: 'Trabajo de producto y plataforma en JavaScript/TypeScript, .NET y Go con límites de servicio mantenibles.',
		items: [
			{ label: 'Lenguajes y runtime', value: 'TypeScript, JavaScript, C#, Go, SQL, Node.js' },
			{ label: 'Frameworks y servicios', value: 'NestJS, React, Next.js, .NET 8, GraphQL, Serverless Framework' },
		],
	},
	'system-integrations': {
		eyebrow: 'Conectividad con proveedores',
		title: 'Conectividad y APIs',
		summary: 'Diseño de sistemas intensivos en integraciones que conectan proveedores travel-tech, motores de cotización y productos SaaS multi-tenant.',
		signal: 'Capas de integración construidas para proveedores hoteleros, flujos de cotización y coordinación de servicios orientada a eventos.',
		items: [
			{ label: 'Integraciones con proveedores', value: 'SiteMinder, TravelClick, Omnibees, Gin RateFox, TravelGate HotelX y otras APIs travel-tech' },
			{ label: 'Datos y caching', value: 'PostgreSQL, MongoDB, Redis, DAX, DynamoDB' },
		],
	},
};

function parseFocusBody(body: string): { summary: string; items: FocusItem[] } {
	const lines = body
		.split('\n')
		.map((line) => line.trim())
		.filter(Boolean);

	const summary = lines.find((line) => !line.startsWith('-')) ?? '';
	const items = lines
		.filter((line) => line.startsWith('-'))
		.map((line) => {
			const strongMatch = line.match(/^-\s+\*\*(.+?)\*\*:\s*(.+)$/);
			if (strongMatch) {
				return {
					label: strongMatch[1],
					value: strongMatch[2],
				};
			}

			return {
				label: 'Note',
				value: line.replace(/^-\s+/, ''),
			};
		});

	return { summary, items };
}

function buildCardGroups(items: FocusItem[]): FocusCardGroup[] {
	return items.slice(0, 2).map((item) => ({ items: [item] }));
}

const dossiers = sectionOrder
	.map((category, index) => {
		const entry = techEntries.find((item) => item.data.category === category);
		if (!entry) return null;

		const { summary, items } = parseFocusBody(entry.body ?? '');
		const spanish = spanishFocusMeta[category];
		const revealDirection = index % 2 === 0 ? 'right' : 'left';
		return {
			index: String(index + 1).padStart(2, '0'),
			revealDirection,
			category,
			title: isSpanish ? spanish.title : entry.data.title,
			summary: isSpanish ? spanish.summary : summary,
			cardGroups: buildCardGroups(isSpanish ? spanish.items : items),
			...focusMeta[category],
			...(isSpanish ? spanish : {}),
		};
	})
	.filter((item): item is NonNullable<typeof item> => item !== null);
---

<section id="technical-focus" class="border-b border-border py-16 section-reveal md:py-20 bg-background">
	<div class="mx-auto max-w-6xl px-4 lg:px-8">
		<div class="fx-reveal mb-10 max-w-3xl md:mb-14">
			<p class="focus-section-kicker mb-3 font-mono text-xs uppercase tracking-[0.22em] text-text-muted" data-i18n="technical.eyebrow">
				{isSpanish ? 'Áreas de capacidad' : 'Capability areas'}
			</p>
			<h2 class="text-2xl font-normal tracking-tight text-text-primary md:text-4xl" data-i18n="technical.title">
				{localizedSectionTitle}
			</h2>
			<p class="mt-3 text-base leading-relaxed text-text-secondary md:text-lg" data-i18n="technical.description">
				{localizedSectionDescription}
			</p>
		</div>

		<div class="space-y-4 md:space-y-5">
			{dossiers.map((focus) => (
				<article
					class="focus-dossier"
					data-reveal-direction={focus.revealDirection}
				>
					<div class="focus-dossier__summary">
						<div class="focus-dossier__index" aria-hidden="true">{focus.index}</div>
						<div class="min-w-0">
							<p class="focus-dossier__eyebrow" data-i18n={`technical.${focus.category}.eyebrow`}>{focus.eyebrow}</p>
							<h3 class="focus-dossier__title" data-i18n={`technical.${focus.category}.title`}>{focus.title}</h3>
							<p class="focus-dossier__description" data-i18n={`technical.${focus.category}.summary`}>{focus.summary}</p>

							<ul class="focus-dossier__tags" role="list">
								{focus.tags.map((tag) => (
									<li class="focus-dossier__tag">{tag}</li>
								))}
							</ul>
						</div>
					</div>

					<div class="focus-dossier__detail">
						<div class="focus-dossier__signal-block">
							<p class="focus-dossier__label" data-i18n="technical.signalLabel">{isSpanish ? 'Señal principal' : 'Primary signal'}</p>
							<p class="focus-dossier__signal" data-i18n={`technical.${focus.category}.signal`}>{focus.signal}</p>
						</div>

						<div class="focus-dossier__items">
							{focus.cardGroups.map((group, groupIndex) => (
								<section class="focus-dossier__detail-card">
									<dl class="focus-dossier__item-stack">
										{group.items.map((item) => (
											<div class="focus-dossier__item-row">
												<dt data-i18n={`technical.${focus.category}.item.${groupIndex}.label`}>{item.label}</dt>
												<dd data-i18n={`technical.${focus.category}.item.${groupIndex}.value`}>{item.value}</dd>
											</div>
										))}
									</dl>
								</section>
							))}
						</div>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<script>
	function initTechnicalFocusReveal() {
		const section = document.getElementById('technical-focus');
		if (!section) return;

		// Guard against double-initialization
		if (section.dataset.revealInitialized === 'true') return;
		section.dataset.revealInitialized = 'true';

		const dossiers = Array.from(section.querySelectorAll('.focus-dossier')) as HTMLElement[];
		if (!dossiers.length) return;

		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (prefersReducedMotion || !('IntersectionObserver' in window)) {
			dossiers.forEach((dossier) => dossier.classList.add('is-visible'));
			return;
		}

		section.classList.add('js-reveal-active');

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				});
			},
			{
				threshold: 0.18,
				rootMargin: '0px 0px -8% 0px',
			}
		);

		dossiers.forEach((dossier, index) => {
			const rect = dossier.getBoundingClientRect();
			const alreadyVisible = rect.top < window.innerHeight * 0.92;

			if (alreadyVisible) {
				dossier.classList.add('is-visible');
				return;
			}

			dossier.style.transitionDelay = `${Math.min(index * 70, 180)}ms`;
			observer.observe(dossier);
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initTechnicalFocusReveal);
	} else {
		initTechnicalFocusReveal();
	}

	document.addEventListener('astro:after-swap', initTechnicalFocusReveal);
</script>

<style>
	.focus-dossier {
		display: grid;
		gap: 1.5rem;
		padding: 1.35rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface-container-low);
		transition:
			opacity 760ms cubic-bezier(0.16, 1, 0.3, 1),
			transform 880ms cubic-bezier(0.16, 1, 0.3, 1);
		will-change: transform, opacity;
	}

	.js-reveal-active .focus-dossier[data-reveal-direction='left'],
	.js-reveal-active .focus-dossier[data-reveal-direction='right'] {
		opacity: 0;
		transform: translateY(24px);
	}

	.js-reveal-active .focus-dossier.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.focus-dossier.is-visible:hover {
		background: var(--color-surface-container);
		border-color: var(--color-border-strong);
	}

	.focus-dossier__summary {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1rem;
		align-items: start;
	}

	.focus-dossier__index {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 3rem;
		height: 3rem;
		padding: 0 0.75rem;
		border: 1px solid var(--color-outline);
		border-radius: var(--radius-sm);
		background: transparent;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
	}

	.focus-dossier__eyebrow,
	.focus-dossier__label {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: var(--color-text-muted);
	}

	.focus-dossier__title {
		margin: 0.45rem 0 0;
		font-size: 1.55rem;
		font-weight: 400;
		letter-spacing: -0.03em;
		color: var(--color-text-primary);
	}

	.focus-dossier__description {
		margin: 0.85rem 0 0;
		max-width: 34rem;
		font-size: 1rem;
		line-height: 1.7;
		color: var(--color-text-secondary);
	}

	.focus-dossier__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}

	.focus-dossier__tag {
		display: inline-flex;
		align-items: center;
		padding: 0.25rem 0.5rem;
		border: 1px solid var(--color-outline);
		border-radius: var(--radius-sm);
		background: transparent;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
	}

	.focus-dossier__detail {
		display: grid;
		gap: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--color-border);
	}

	.focus-dossier__signal-block {
		display: grid;
		gap: 0.35rem;
	}

	.focus-dossier__signal {
		margin: 0;
		max-width: 34rem;
		font-size: 0.93rem;
		line-height: 1.55;
		color: var(--color-text-primary);
	}

	.focus-dossier__items {
		display: grid;
		gap: 0.8rem;
		margin: 0;
	}

	.focus-dossier__detail-card {
		display: grid;
		min-height: 7.5rem;
		padding: 0.8rem 0.9rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface-container-lowest);
	}

	.focus-dossier__item-stack {
		display: grid;
		gap: 0.7rem;
		margin: 0;
	}

	.focus-dossier__item-row {
		display: grid;
		gap: 0.22rem;
	}

	.focus-dossier__item-row + .focus-dossier__item-row {
		padding-top: 0.7rem;
		border-top: 1px solid var(--color-border);
	}

	.focus-dossier__item-row dt {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.focus-dossier__item-row dd {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--color-text-secondary);
	}

	@media (min-width: 64rem) {
		.focus-dossier {
			grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
			gap: 2rem;
			padding: 1.7rem;
		}

		.focus-dossier__detail {
			padding-top: 0;
			padding-left: 2rem;
			border-top: 0;
			border-left: 1px solid var(--color-border);
		}

		.focus-dossier__items {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.focus-dossier,
		.focus-dossier[data-reveal-direction='left'],
		.focus-dossier[data-reveal-direction='right'],
		.js-reveal-active .focus-dossier[data-reveal-direction='left'],
		.js-reveal-active .focus-dossier[data-reveal-direction='right'] {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}
</style>
