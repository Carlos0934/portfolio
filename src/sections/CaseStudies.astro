---
import { getCollection } from 'astro:content';
import { useTranslations, type Locale } from '../lib/i18n';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const cases = (await getCollection('caseStudies')).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const displayUrl = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<section id="case-studies" class="work" data-reveal>
	<div class="bg-decor" aria-hidden="true">
		<div class="bg-dots work-dots"></div>
	</div>

	<div class="relative mx-auto max-w-6xl px-4 lg:px-8">
		<p class="section-label" data-reveal-item data-i18n="cases.eyebrow">{t('cases.eyebrow', 'Selected work')}</p>
		<h2 class="section-title mt-4" data-reveal-item style="--reveal-delay: 70ms;" data-i18n="cases.title">
			{t('cases.title', 'Real problems, measurable results.')}
		</h2>

		<ul class="work-grid" role="list">
			{cases.map((item, index) => {
				const key = `case.${item.data.slug}`;
				return (
					<li class="work-card" data-reveal-item style={`--reveal-delay: ${120 + index * 70}ms;`}>
						<p class="work-card__meta">
							{item.data.client && <b>{item.data.client}</b>}
							{item.data.sector && <span data-i18n={`${key}.sector`}>{t(`${key}.sector`, item.data.sector)}</span>}
						</p>
						<h3 class="work-card__title" data-i18n={`${key}.title`}>{t(`${key}.title`, item.data.title)}</h3>
						<p class="work-card__summary" data-i18n={`${key}.summary`}>{t(`${key}.summary`, item.data.summary)}</p>
						<div class="work-card__foot">
							{item.data.stack && <span class="work-card__stack">{item.data.stack}</span>}
							{item.data.url && (
								<a class="work-card__link" href={item.data.url} target="_blank" rel="noopener noreferrer">
									{displayUrl(item.data.url)}
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
										<path d="M7 17 17 7M8 7h9v9" />
									</svg>
								</a>
							)}
						</div>
					</li>
				);
			})}
		</ul>
	</div>
</section>

<style>
	.work {
		position: relative;
		padding: 5rem 0;
	}

	.work-dots {
		--dots-mask: radial-gradient(ellipse 50% 50% at 8% 15%, #000 20%, transparent 70%);
	}

	.work-grid {
		display: grid;
		gap: 1.25rem;
		margin: 3rem 0 0;
		padding: 0;
		list-style: none;
	}

	.work-card {
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background: var(--color-surface-container-lowest);
		box-shadow: var(--shadow-card);
	}

	.work-card__meta {
		display: flex;
		flex-wrap: wrap;
		margin: 0;
		font-size: 0.82rem;
		color: var(--color-text-muted);
	}

	.work-card__meta b {
		font-weight: 500;
		color: var(--color-text-primary);
	}

	.work-card__meta b + span::before {
		content: "\00a0·\00a0";
	}

	.work-card__title {
		margin: 0.6rem 0 0;
		font-size: 1.3rem;
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	.work-card__summary {
		margin: 0.6rem 0 0;
		font-size: 0.96rem;
		line-height: 1.65;
		color: var(--color-text-secondary);
	}

	.work-card__foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: auto;
		padding-top: 1.25rem;
	}

	.work-card__stack {
		font-size: 0.82rem;
		color: var(--color-text-muted);
	}

	.work-card__link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--color-primary);
		text-decoration: none;
		white-space: nowrap;
	}

	.work-card__link svg {
		width: 0.9rem;
		height: 0.9rem;
		transition: transform var(--fx-duration-fast) ease;
	}

	.work-card__link:hover,
	.work-card__link:focus-visible {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.work-card__link:hover svg {
		transform: translate(2px, -2px);
	}

	@media (min-width: 48rem) {
		.work {
			padding: 7rem 0;
		}

		.work-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.work-card {
			padding: 1.75rem;
		}
	}
</style>
