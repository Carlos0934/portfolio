---
import { getCollection, render } from 'astro:content';
import { LINKEDIN_URL, GITHUB_URL } from '../consts';

const contactEntries = await getCollection('contact');
const contact = contactEntries[0];
const { Content } = await render(contact);
const { title, location, linkedinUrl, linkedinHandle, githubUrl, githubHandle } = contact.data;

// Derive handles from URLs if not provided in frontmatter
const displayHandle = linkedinHandle || linkedinUrl?.split('/in/')[1]?.replace('/', '') || '';
const linkedInHref = linkedinUrl || LINKEDIN_URL;
const githubHref = githubUrl || GITHUB_URL;
const githubUser = githubHandle || githubUrl?.split('github.com/')[1]?.replace('/', '') || '';
---

<section id="contact" class="border-b border-border bg-surface py-16 md:py-20 lg:py-24 section-reveal">
	<div class="mx-auto max-w-4xl px-4">
		<!-- Section Heading -->
		<div class="fx-reveal-up mb-10 border-b border-border pb-6">
			<h2 class="text-2xl font-bold tracking-tight text-text-primary md:text-3xl">
				{title}
			</h2>
		</div>

		<!-- Contact Block: Systems-oriented information grouping -->
		<div class="space-y-8">
			<!-- Primary Location Row -->
			<div class="fx-reveal">
			{location && (
				<div>
					<span class="font-mono text-xs uppercase tracking-wider text-text-muted">
						Location
					</span>
					<div class="mt-3 flex items-center gap-3 text-text-primary">
						<svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
						<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
					</svg>
					<span class="text-xl font-semibold tracking-tight md:text-2xl">{location}</span>
					</div>
				</div>
			)}
			</div>

			<!-- Availability Statement -->
			<div class="fx-reveal prose prose-invert max-w-none text-text-secondary">
				<Content />
			</div>

			<!-- Contact Channels -->
			<div class="fx-reveal-up border-t border-border pt-8">
				<span class="font-mono text-xs uppercase tracking-wider text-text-muted">
					Channels
				</span>
				<div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-center">
					<a
						href={linkedInHref}
						target="_blank"
						rel="noopener noreferrer"
						class="fx-hover-lift inline-flex items-center gap-3 rounded-lg bg-primary px-6 py-3 font-medium text-text-primary transition-colors hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
					>
						<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
						</svg>
						<span>Connect on LinkedIn</span>
					</a>

					<a
						href={githubHref}
						target="_blank"
						rel="noopener noreferrer"
						class="fx-hover-border inline-flex items-center gap-3 rounded-lg border border-border bg-surface-alt px-6 py-3 font-medium text-text-primary transition-colors hover:bg-surface hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
					>
						<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
						</svg>
						<span>GitHub</span>
					</a>
				</div>
				<div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm text-text-muted">
					{displayHandle && <span>@{displayHandle}</span>}
					{githubUser && <span>{githubUser}</span>}
				</div>
			</div>
		</div>
	</div>
</section>
