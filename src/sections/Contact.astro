---
import { getCollection } from 'astro:content';
import { LINKEDIN_URL, GITHUB_URL } from '../consts';
interface Props {
	locale?: 'en' | 'es';
}
const { locale = 'en' } = Astro.props;
const isSpanish = locale === 'es';

const contactEntries = await getCollection('contact');
const contact = contactEntries[0];
const { location, linkedinUrl, linkedinHandle, githubUrl, githubHandle, email } = contact.data;

// Derive handles from URLs if not provided in frontmatter
const displayHandle = linkedinHandle || linkedinUrl?.split('/in/')[1]?.replace('/', '') || '';
const linkedInHref = linkedinUrl || LINKEDIN_URL;
const githubHref = githubUrl || GITHUB_URL;
const githubUser = githubHandle || githubUrl?.split('github.com/')[1]?.replace('/', '') || '';
---

<section id="contact" class="border-b border-border bg-surface-container-lowest py-16 md:py-20 lg:py-28 section-reveal">
	<div class="mx-auto max-w-4xl px-4">
		<!-- CTA Header -->
		<div class="fx-reveal-up mb-10 md:mb-14">
			<p class="mb-3 font-mono text-xs uppercase tracking-[0.22em] text-text-muted" data-i18n="contact.eyebrow">
				{isSpanish ? 'Siguiente paso' : 'Next step'}
			</p>
			<h2 class="text-2xl font-normal tracking-tight text-text-primary md:text-4xl" data-i18n="contact.title">
				{isSpanish ? 'Construyamos algo que llegue a producción.' : "Let's build something that ships."}
			</h2>
			<p class="mt-3 max-w-2xl text-base leading-relaxed text-text-secondary md:text-lg" data-i18n="contact.description">
				{isSpanish ? 'Basado en EE. UU., trabajando con equipos y productos en República Dominicana. Abierto a roles backend, plataforma e integraciones complejas, remoto o híbrido. Si necesitas un ingeniero que mejora sistemas y entrega con confiabilidad, conversemos.' : "US-based, working with teams and products across the Dominican Republic. Open to backend, platform, and integration-heavy roles — remote or hybrid. If you need an engineer who improves systems and delivers reliably, let's talk."}
			</p>
		</div>

		<!-- Contact Block -->
		<div class="space-y-8">
			<!-- Email — Primary CTA -->
			{email && (
				<div class="fx-reveal">
					<span class="font-mono text-xs uppercase tracking-wider text-text-muted" data-i18n="contact.direct">
						{isSpanish ? 'Contacto directo' : 'Direct contact'}
					</span>
					<div class="mt-3">
						<a
							href={`mailto:${email}`}
							class="group inline-flex items-center gap-3 rounded-lg bg-primary px-6 py-3.5 font-mono text-sm uppercase tracking-[1.4px] text-text-primary transition-colors hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
						>
							<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
							</svg>
							<span>{email}</span>
						</a>
					</div>
				</div>
			)}

			<!-- Location Row -->
			{location && (
				<div class="fx-reveal">
					<span class="font-mono text-xs uppercase tracking-wider text-text-muted" data-i18n="contact.location">
						{isSpanish ? 'Ubicación' : 'Location'}
					</span>
					<div class="mt-2 flex items-center gap-2 text-text-primary">
						<svg class="h-4 w-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
							<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
						</svg>
						<span class="text-base font-normal tracking-tight">{location}</span>
					</div>
				</div>
			)}

			<!-- Contact Channels -->
			<div class="fx-reveal-up border-t border-border pt-8">
				<span class="font-mono text-xs uppercase tracking-wider text-text-muted" data-i18n="contact.profiles">
					{isSpanish ? 'Perfiles' : 'Profiles'}
				</span>
				<div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-center">
					<a
						href={linkedInHref}
						target="_blank"
						rel="noopener noreferrer"
						class="fx-hover-dim inline-flex w-full items-center justify-center gap-3 rounded-lg bg-primary px-6 py-3 text-center font-mono text-sm uppercase tracking-[1.4px] text-text-primary transition-colors hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background sm:w-auto"
					>
						<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
						</svg>
						<span>LinkedIn</span>
					</a>

					<a
						href={githubHref}
						target="_blank"
						rel="noopener noreferrer"
						class="fx-hover-border inline-flex w-full items-center justify-center gap-3 rounded-lg border border-border-strong bg-surface-container-low px-6 py-3 text-center font-mono text-sm uppercase tracking-[1.4px] text-text-primary transition-colors hover:bg-surface-container hover:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background sm:w-auto"
					>
						<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
						</svg>
						<span>GitHub</span>
					</a>
				</div>
				<div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm text-text-muted">
					{displayHandle && <span>@{displayHandle}</span>}
					{githubUser && <span>{githubUser}</span>}
				</div>
			</div>
		</div>
	</div>
</section>
