---
import { getCollection, render } from 'astro:content';
import { LINKEDIN_URL } from '../consts';

const contactEntries = await getCollection('contact');
const contact = contactEntries[0];
const { Content } = await render(contact);
const { title, location, linkedinUrl, linkedinHandle } = contact.data;

// Derive handle from URL if not provided in frontmatter
const displayHandle = linkedinHandle || linkedinUrl?.split('/in/')[1]?.replace('/', '') || '';
const linkedInHref = linkedinUrl || LINKEDIN_URL;
---

<section id="contact" class="border-b border-border bg-surface py-16 md:py-20 lg:py-24 section-reveal">
	<div class="mx-auto max-w-4xl px-4">
		<!-- Section Heading -->
		<div class="mb-10 border-b border-border pb-6">
			<h2 class="text-2xl font-bold tracking-tight text-text-primary md:text-3xl">
				{title}
			</h2>
		</div>

		<!-- Contact Block: Systems-oriented information grouping -->
		<div class="space-y-8">
			<!-- Primary Location Row -->
			<div>
				{location && (
					<div>
						<span class="font-mono text-xs uppercase tracking-wider text-text-muted">
							Location
						</span>
						<div class="mt-3 flex items-center gap-3 text-text-primary">
							<svg class="h-5 w-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
							<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
						</svg>
						<span class="text-xl font-semibold tracking-tight md:text-2xl">{location}</span>
						</div>
					</div>
				)}
			</div>

			<!-- Availability Statement -->
			<div class="prose prose-invert max-w-none text-text-secondary">
				<Content />
			</div>

			<!-- Contact Channel -->
			<div class="border-t border-border pt-8">
				<span class="font-mono text-xs uppercase tracking-wider text-text-muted">
					Channel
				</span>
				<div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-center">
					<a
						href={linkedInHref}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-3 rounded-lg bg-primary px-6 py-3 font-medium text-text-primary transition-colors hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
					>
						<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
						</svg>
						<span>Connect on LinkedIn</span>
					</a>

					{displayHandle && (
						<code class="font-mono text-sm text-text-muted">
							@{displayHandle}
						</code>
					)}
				</div>
			</div>
		</div>
	</div>
</section>
