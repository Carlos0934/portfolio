---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import profileImage from '../assets/profile.png';

const heroEntries = await getCollection('hero');
const hero = heroEntries[0];
const { Content } = await render(hero);
const { title, tagline, description, eyebrow, proofSignals } = hero.data;
interface Props {
	locale?: 'en' | 'es';
}
const { locale = 'en' } = Astro.props;
const isSpanish = locale === 'es';
const heroText = {
	eyebrow: isSpanish ? 'EE. UU. y República Dominicana · Abierto a remoto o híbrido' : eyebrow,
	tagline: isSpanish ? 'Construyo sistemas backend para productos que necesitan escalar, integrarse y seguir funcionando.' : tagline,
	description: isSpanish
		? 'Mi trabajo reciente se ha enfocado en APIs, infraestructura y confiabilidad para productos SaaS y travel-tech. Trabajo cerca del producto cuando la arquitectura, las integraciones y la claridad operativa importan, ayudando a los equipos a entregar con confianza y mantener sistemas sostenibles mientras crecen.'
		: description,
	proofSignals: isSpanish
		? [
				{ value: 'SaaS', label: 'Trabajo de plataforma' },
				{ value: 'Travel-tech', label: 'Integraciones complejas' },
				{ value: 'Confiabilidad', label: 'Foco de entrega' },
			]
		: proofSignals,
};
---

<section id="hero" class="border-b border-border py-6 sm:py-8 md:py-14 lg:py-16 section-reveal bg-background">
	<div class="mx-auto max-w-6xl px-4 lg:px-8">
		<div class="grid gap-5 sm:gap-6 md:gap-8 lg:grid-cols-5 lg:gap-12">
			<!-- Left Column: Content Stack -->
			<div class="lg:col-span-3 flex flex-col">
				<!-- Eyebrow / Availability status -->
				{heroText.eyebrow && (
					<div class="fx-entrance fx-entrance-delay-1 mb-1.5 flex items-center gap-2 md:mb-2">
						<span class="relative flex h-2 w-2">
							<span class="absolute inline-flex h-full w-full animate-pulse rounded-full bg-signal opacity-75"></span>
							<span class="relative inline-flex h-2 w-2 rounded-full bg-signal"></span>
						</span>
						<span class="eyebrow-status font-mono text-sm uppercase tracking-wider text-text-secondary" data-i18n="hero.eyebrow">
							{heroText.eyebrow}
							<span class="eyebrow-status__cursor" aria-hidden="true"></span>
						</span>
					</div>
				)}

				<!-- Mobile Intro Row -->
				<div class="fx-entrance fx-entrance-delay-2 mb-2 flex items-center gap-3 md:hidden">
					<div class="min-w-0 flex-1">
						<h1 class="mb-1.5 text-[1.9rem] leading-[0.96] font-mono font-light tracking-tight text-text-primary sm:text-[2.1rem]">
							{title}
						</h1>
						{heroText.tagline && (
							<p class="max-w-[22ch] text-sm font-sans font-normal leading-snug text-text-secondary sm:text-[0.95rem]" data-i18n="hero.tagline">
								{heroText.tagline}
							</p>
						)}
					</div>

					<div class="hero-portrait-panel hero-portrait-panel--compact shrink-0" aria-hidden="true">
						<div class="hero-portrait-panel__frame">
							<Image
								src={profileImage}
								alt=""
								class="hero-portrait-panel__image"
								width={220}
								height={300}
								loading="eager"
								decoding="async"
							/>
						</div>
					</div>
				</div>

				<!-- Title -->
				<h1 class="fx-entrance fx-entrance-delay-2 mb-1.5 hidden text-4xl font-mono font-light tracking-tight text-text-primary md:block md:text-[2.8rem] lg:text-5xl">
					{title}
				</h1>

				<!-- Tagline -->
				{heroText.tagline && (
					<p class="fx-entrance fx-entrance-delay-3 mb-3 hidden text-lg font-sans font-normal leading-snug text-text-secondary md:mb-4 md:block md:text-xl lg:text-2xl lg:leading-snug" data-i18n="hero.tagline">
						{heroText.tagline}
					</p>
				)}

				<!-- Description -->
				{heroText.description && (
					<p class="fx-entrance fx-entrance-delay-4 mb-3 max-w-prose text-[0.95rem] leading-relaxed text-text-secondary sm:text-base md:mb-4 md:text-lg" data-i18n="hero.description">
						{heroText.description}
					</p>
				)}

				<!-- Content Body (Markdown) -->
				<div class="fx-entrance fx-entrance-delay-5 mb-4 prose prose-invert prose-sm max-w-none text-text-secondary md:mb-6">
					<Content />
				</div>

				<!-- Proof Signals -->
				{heroText.proofSignals && heroText.proofSignals.length > 0 && (
					<div class="fx-entrance fx-entrance-delay-5 mb-4 flex flex-wrap gap-3 md:mb-6">
						{heroText.proofSignals.map((signal, index) => (
							<div class="flex min-w-0 flex-col gap-0.5 rounded-lg border border-border bg-surface-container-low px-2.5 py-1.5">
								<span class="font-mono text-xl font-light tracking-tight text-text-primary md:text-2xl" data-i18n={`hero.signal.${index}.value`}>
									{signal.value}
								</span>
								<span class="font-mono text-[0.7rem] uppercase tracking-[0.12em] text-text-secondary md:text-sm md:tracking-wider" data-i18n={`hero.signal.${index}.label`}>
									{signal.label}
								</span>
							</div>
						))}
					</div>
				)}

			</div>

			<!-- Right Column: Visual Area -->
			<div class="fx-reveal-scale hidden -mt-1 md:flex lg:col-span-2 items-start justify-center lg:mt-0 lg:items-center lg:justify-end lg:pl-8">
				<div class="relative">
					<!-- Profile Photo Area -->
					<div class="hero-portrait-panel hero-portrait-panel--desktop">
						<div class="hero-portrait-panel__frame">
							<Image
								src={profileImage}
								alt={title}
								class="hero-portrait-panel__image"
								width={420}
								height={540}
								loading="eager"
								decoding="async"
							/>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-portrait-panel {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem;
		border-radius: var(--radius-lg);
		background: var(--color-surface-container-low);
		border: 1px solid var(--color-border);
		overflow: hidden;
	}

	.hero-portrait-panel--compact {
		width: 5.1rem;
		aspect-ratio: 0.68;
		padding: 0.25rem;
	}

	.hero-portrait-panel--desktop {
		width: min(22rem, 30vw);
		aspect-ratio: 0.78;
	}

	.hero-portrait-panel__frame {
		position: relative;
		width: 100%;
		height: 100%;
		min-height: 100%;
		overflow: hidden;
		border-radius: var(--radius-md);
		background: var(--color-surface-container-low);
		border: 1px solid var(--color-border);
	}

	.hero-portrait-panel__image {
		height: 100%;
		width: 100%;
		object-fit: cover;
		object-position: center 22%;
	}

	@media (min-width: 48rem) {
		.hero-portrait-panel {
			padding: 0.6rem;
		}

		.hero-portrait-panel--compact {
			width: 7.5rem;
			aspect-ratio: 0.72;
			padding: 0.3rem;
		}
	}
</style>
