---
import { getCollection, render } from 'astro:content';

const heroEntries = await getCollection('hero');
const hero = heroEntries[0];
const { Content } = await render(hero);
const { title, tagline, description, eyebrow, proofSignals, resumeUrl } = hero.data;
---

<section id="hero" class="border-b border-border py-16 md:py-20 lg:py-24 section-reveal">
	<div class="mx-auto max-w-6xl px-4 lg:px-8">
		<div class="grid gap-12 lg:grid-cols-5 lg:gap-16">
			<!-- Left Column: Content Stack -->
			<div class="lg:col-span-3 flex flex-col">
				<!-- Logo Placeholder -->
				<div class="mb-8 flex items-center gap-3" aria-hidden="true">
					<div class="flex h-10 w-10 items-center justify-center rounded-lg border border-border-strong bg-surface-elevated">
						<svg class="h-5 w-5 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
						</svg>
					</div>
					<span class="font-mono text-sm text-text-muted">your-logo</span>
				</div>

				<!-- Eyebrow / Status with subtle cursor -->
				{eyebrow && (
					<div class="mb-3 flex items-center gap-2">
						<span class="relative flex h-2 w-2">
							<span class="absolute inline-flex h-full w-full animate-pulse rounded-full bg-signal opacity-75"></span>
							<span class="relative inline-flex h-2 w-2 rounded-full bg-signal"></span>
						</span>
						<span class="eyebrow-status font-mono text-sm uppercase tracking-wider text-text-muted">
							{eyebrow}
							<span class="eyebrow-status__cursor" aria-hidden="true"></span>
						</span>
					</div>
				)}

				<!-- Title -->
				<h1 class="mb-2 text-4xl font-bold tracking-tight text-text-primary md:text-5xl lg:text-6xl">
					{title}
				</h1>

				<!-- Tagline -->
				{tagline && (
					<p class="mb-4 text-xl font-medium text-primary md:text-2xl">
						{tagline}
					</p>
				)}

				<!-- Description -->
				{description && (
					<p class="mb-6 max-w-prose text-lg leading-relaxed tracking-wide text-text-secondary md:text-xl md:leading-relaxed">
						{description}
					</p>
				)}

				<!-- Content Body (Markdown) -->
				<div class="mb-8 prose prose-invert prose-sm max-w-none text-text-secondary">
					<Content />
				</div>

				<!-- Proof Signals -->
				{proofSignals && proofSignals.length > 0 && (
					<div class="mb-8 flex flex-wrap gap-6 border-l-2 border-border pl-4">
						{proofSignals.map((signal) => (
							<div class="flex flex-col">
								<span class="font-mono text-2xl font-bold text-text-primary">
									{signal.value}
								</span>
								<span class="font-mono text-xs uppercase tracking-wider text-text-muted">
									{signal.label}
								</span>
							</div>
						))}
					</div>
				)}

				<!-- CTA Row -->
				<div class="flex flex-wrap gap-3">
					<a
						href="#contact"
						class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-3 font-medium text-text-primary transition-colors hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
					>
						<span>Contact</span>
						<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
						</svg>
					</a>
					<a
						href={resumeUrl || '#'}
						class="inline-flex items-center gap-2 rounded-lg border border-border-strong bg-surface-elevated px-5 py-3 font-medium text-text-secondary transition-colors hover:border-border hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
					>
						<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
						</svg>
						<span>Resume</span>
					</a>
				</div>
			</div>

			<!-- Right Column: Visual Area -->
			<div class="lg:col-span-2 flex items-center justify-center lg:justify-end">
				<div class="relative">
					<!-- Subtle decorative circles - supporting elements -->
					<div class="absolute -left-8 -top-8 h-32 w-32 rounded-full border border-border opacity-20" aria-hidden="true"></div>
					<div class="absolute -bottom-12 -right-12 h-48 w-48 rounded-full border border-border opacity-10" aria-hidden="true"></div>
					<div class="absolute left-1/2 top-1/2 h-64 w-64 -translate-x-1/3 -translate-y-1/3 rounded-full bg-gradient-to-br from-primary/5 to-transparent" aria-hidden="true"></div>

					<!-- Profile Photo Placeholder -->
					<div class="relative z-10 flex items-center justify-center">
						<div class="flex h-48 w-48 items-center justify-center overflow-hidden rounded-full border-2 border-border-strong bg-surface-elevated md:h-56 md:w-56 lg:h-64 lg:w-64" aria-hidden="true">
							<!-- Placeholder initials -->
							<span class="text-4xl font-bold text-text-muted md:text-5xl lg:text-6xl">
								CG
							</span>
						</div>
						<!-- Small accent circle near photo -->
						<div class="absolute -bottom-2 -right-2 flex h-8 w-8 items-center justify-center rounded-full border-2 border-background bg-surface-elevated" aria-hidden="true">
							<div class="h-3 w-3 rounded-full bg-signal"></div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>