---
import { Image } from 'astro:assets';
import profileImage from '../assets/profile-portrait.png';
import { AUTHOR_NAME } from '../consts';
import { useTranslations, type Locale } from '../lib/i18n';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = useTranslations(locale);
---

<section id="hero" class="hero">
	<div class="bg-decor" aria-hidden="true">
		<div class="bg-glow hero-glow hero-glow--right"></div>
		<div class="bg-glow hero-glow hero-glow--left"></div>
		<div class="bg-dots"></div>
	</div>

	<div class="hero-grid mx-auto max-w-6xl px-4 lg:px-8">
		<div class="hero-copy">
			<p class="hero-eyebrow fx-entrance fx-entrance-delay-1">
				<span data-i18n="hero.role">{t('hero.role', 'Senior Software Engineer')}</span>
				<span class="hero-eyebrow__dot" aria-hidden="true"></span>
				<span data-i18n="hero.location">{t('hero.location', 'Georgia, US')}</span>
			</p>

			<h1 class="hero-title fx-entrance fx-entrance-delay-2">
				<span class="hero-title__greeting" data-i18n="hero.greeting">{t('hero.greeting', "Hi, I'm Carlos.")}</span>
				<span data-i18n="hero.headline">{t('hero.headline', 'I turn concrete problems into')}</span>{' '}
				<em data-i18n="hero.headline.em">{t('hero.headline.em', 'simple, effective products.')}</em>
			</h1>

			<p class="hero-lead fx-entrance fx-entrance-delay-3" data-i18n="hero.lead">
				{t('hero.lead', 'Backend engineer by trade, comfortable across the stack. I like taking a real problem from idea to production, end to end, and using AI to get there faster.')}
			</p>

			<div class="hero-ctas fx-entrance fx-entrance-delay-4">
				<a href="#journey" class="button-solid" data-i18n="hero.cta.primary">{t('hero.cta.primary', 'Follow my journey')}</a>
				<a href="#contact" class="button-outline" data-i18n="hero.cta.secondary">{t('hero.cta.secondary', 'Get in touch')}</a>
			</div>
		</div>

		<div class="hero-portrait fx-entrance fx-entrance-delay-3">
			<Image
				src={profileImage}
				alt={AUTHOR_NAME}
				class="hero-portrait__image"
				widths={[360, 540, 720]}
				sizes="(min-width: 64rem) 23rem, (min-width: 48rem) 40vw, 80vw"
				loading="eager"
				fetchpriority="high"
			/>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		padding: 3rem 0 5rem;
	}

	.hero-glow--right {
		width: 35rem;
		height: 35rem;
		right: -9rem;
		top: -8rem;
		background: var(--color-glow);
	}

	.hero-glow--left {
		width: 26rem;
		height: 26rem;
		left: -11rem;
		top: 18rem;
		background: var(--color-glow-soft);
	}

	.hero-grid {
		position: relative;
		display: grid;
		gap: 3rem;
		align-items: center;
	}

	.hero-eyebrow {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		font-size: 0.9rem;
		color: var(--color-text-secondary);
	}

	.hero-eyebrow__dot {
		width: 4px;
		height: 4px;
		border-radius: 9999px;
		background: var(--color-text-muted);
	}

	.hero-title {
		margin: 1.25rem 0 0;
		font-size: clamp(2.6rem, 1.6rem + 3.6vw, 3.9rem);
		font-weight: 600;
		line-height: 1.04;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}

	.hero-title__greeting {
		display: block;
	}

	.hero-title em {
		font-style: normal;
		color: var(--color-primary);
	}

	.hero-lead {
		max-width: 34rem;
		margin: 1.6rem 0 0;
		font-size: clamp(1.05rem, 1rem + 0.25vw, 1.2rem);
		line-height: 1.7;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.hero-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.25rem;
	}

	.hero-portrait {
		position: relative;
		width: min(100%, 23rem);
	}

	/* Offset hairline frame behind the photo */
	.hero-portrait::before {
		content: "";
		position: absolute;
		inset: 0;
		border: 1px solid var(--color-border-strong);
		border-radius: 22px;
		transform: translate(1.1rem, 1.1rem);
	}

	.hero-portrait__image {
		position: relative;
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 22px;
		box-shadow: var(--shadow-card);
	}

	@media (max-width: 47.99rem) {
		.hero-ctas a {
			flex: 1 1 12rem;
		}

		.hero-portrait {
			width: min(62%, 15rem);
		}
	}

	@media (min-width: 48rem) {
		.hero {
			padding: 4rem 0 7rem;
		}

		.hero-grid {
			grid-template-columns: 1.3fr 1fr;
			gap: 4rem;
		}

		.hero-portrait {
			justify-self: end;
		}
	}
</style>
