---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import profileImage from '../assets/profile-portrait.png';

const heroEntries = await getCollection('hero');
const hero = heroEntries[0];
const { title, tagline, description, eyebrow, proofSignals } = hero.data;
interface Props {
	locale?: 'en' | 'es';
}
const { locale = 'en' } = Astro.props;
const isSpanish = locale === 'es';
const heroText = {
	eyebrow: isSpanish ? 'Senior Software Engineer · Abierto a roles remotos o híbridos' : eyebrow,
	tagline: isSpanish
		? 'Construyo sistemas backend que ahorran tiempo a los equipos y mantienen rápidos y confiables los flujos que generan ingresos.'
		: tagline,
	description: isSpanish
		? 'Ingeniero de software senior en productos travel-tech, SaaS y educación. Trabajo cerca del problema de negocio: conectar los sistemas de los que depende un equipo, eliminar trabajo manual y hacer más rápidos y estables los flujos que generan ingresos.'
		: description,
	proofSignals: isSpanish
		? [
				{ value: '−75%', label: 'Menos tiempo de preparación de exámenes con Sócrates' },
				{ value: '9', label: 'Integraciones con proveedores hoteleros construidas o reforzadas' },
				{ value: '−50%', label: 'Tiempo de arranque en serverless' },
			]
		: proofSignals,
	primaryCta: isSpanish ? 'Ver trabajo seleccionado' : 'See selected work',
	secondaryCta: isSpanish ? 'Ver CV' : 'View CV',
};
const cvHref = isSpanish ? '/es/cv/' : '/cv/';
---

<section id="hero" class="hero border-b border-border bg-background">
	<div class="mx-auto max-w-6xl px-4 py-14 md:py-20 lg:px-8 lg:py-24">
		<div class="hero-grid">
			<div class="hero-copy min-w-0">
				{heroText.eyebrow && (
					<div class="fx-entrance fx-entrance-delay-1 mb-6 flex items-center gap-3">
						<Image
							src={profileImage}
							alt=""
							class="hero-avatar md:hidden"
							width={96}
							height={96}
							loading="eager"
							decoding="async"
						/>
						<p class="section-label" data-i18n="hero.eyebrow">{heroText.eyebrow}</p>
					</div>
				)}

				<h1 class="fx-entrance fx-entrance-delay-2 hero-title">
					{title}
				</h1>

				{heroText.tagline && (
					<p class="fx-entrance fx-entrance-delay-3 hero-tagline" data-i18n="hero.tagline">
						{heroText.tagline}
					</p>
				)}

				{heroText.description && (
					<p class="fx-entrance fx-entrance-delay-4 hero-description" data-i18n="hero.description">
						{heroText.description}
					</p>
				)}

				<div class="fx-entrance fx-entrance-delay-4 mt-8 flex flex-wrap gap-3">
					<a href="#case-studies" class="hero-button hero-button--primary" data-i18n="hero.cta.primary">
						{heroText.primaryCta}
					</a>
					<a href={cvHref} class="hero-button hero-button--secondary" data-i18n="hero.cta.secondary">
						{heroText.secondaryCta}
					</a>
				</div>
			</div>

			<div class="fx-entrance fx-entrance-delay-3 hidden md:block">
				<div class="hero-portrait">
					<Image
						src={profileImage}
						alt={title}
						class="hero-portrait__image"
						width={720}
						height={900}
						loading="eager"
						decoding="async"
					/>
				</div>
			</div>
		</div>

		{heroText.proofSignals && heroText.proofSignals.length > 0 && (
			<ul class="fx-entrance fx-entrance-delay-5 hero-metrics" role="list">
				{heroText.proofSignals.map((signal, index) => (
					<li class="hero-metric">
						<span class="hero-metric__value" data-i18n={`hero.signal.${index}.value`}>{signal.value}</span>
						<span class="hero-metric__label" data-i18n={`hero.signal.${index}.label`}>{signal.label}</span>
					</li>
				))}
			</ul>
		)}
	</div>
</section>

<style>
	.hero-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(3.25rem, 2rem + 6vw, 6.25rem);
		font-weight: 400;
		line-height: 0.95;
		letter-spacing: -0.02em;
		color: var(--color-text-primary);
	}

	.hero-tagline {
		margin: 1.5rem 0 0;
		max-width: 36rem;
		font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem);
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: -0.015em;
		color: var(--color-text-primary);
		text-wrap: balance;
	}

	.hero-description {
		margin: 1rem 0 0;
		max-width: 38rem;
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.hero-avatar {
		width: 3rem;
		height: 3rem;
		border-radius: var(--radius-full);
		object-fit: cover;
		object-position: center 30%;
	}

	.hero-portrait {
		width: 100%;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: var(--radius-xl);
		background: var(--color-surface-container-low);
	}

	.hero-portrait__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3rem;
		padding: 0 1.5rem;
		border: 1px solid transparent;
		border-radius: var(--radius-interactive);
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			background-color var(--fx-duration-fast) ease,
			border-color var(--fx-duration-fast) ease,
			color var(--fx-duration-fast) ease;
	}

	.hero-button--primary {
		background: var(--color-primary);
		color: var(--color-on-primary);
	}

	.hero-button--primary:hover,
	.hero-button--primary:focus-visible {
		background: var(--color-primary-hover);
	}

	.hero-button--secondary {
		border-color: var(--color-border-strong);
		color: var(--color-text-primary);
	}

	.hero-button--secondary:hover,
	.hero-button--secondary:focus-visible {
		border-color: var(--color-text-primary);
	}

	/* Hero and metrics share the same 3-column grid so the third metric lines up with the photo. */
	.hero-grid {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	.hero-metrics {
		display: grid;
		gap: 1.75rem;
		margin: 3.5rem 0 0;
		padding: 2rem 0 0;
		border-top: 1px solid var(--color-border-strong);
		list-style: none;
	}

	.hero-metric {
		display: grid;
		gap: 0.4rem;
		align-content: start;
	}

	.hero-metric__value {
		font-family: var(--font-display);
		font-size: clamp(3rem, 2.4rem + 2.4vw, 4.25rem);
		line-height: 1;
		letter-spacing: -0.02em;
		color: var(--color-primary);
	}

	.hero-metric__label {
		max-width: 16rem;
		font-size: 0.95rem;
		line-height: 1.45;
		color: var(--color-text-secondary);
	}

	@media (min-width: 48rem) {
		.hero-grid,
		.hero-metrics {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			column-gap: 3rem;
		}

		.hero-copy {
			grid-column: span 2;
		}
	}
</style>
