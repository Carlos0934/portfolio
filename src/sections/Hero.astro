---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { LINKEDIN_URL } from '../consts';
import LogoMark from '../components/LogoMark.astro';
import profileImage from '../assets/profile.png';
import resumeFile from '../assets/resume.pdf?url';

const heroEntries = await getCollection('hero');
const hero = heroEntries[0];
const contactEntries = await getCollection('contact');
const contact = contactEntries[0];
const { Content } = await render(hero);
const { title, tagline, description, eyebrow, proofSignals, resumeUrl } = hero.data;
const { linkedinUrl } = contact.data;
const linkedInHref = linkedinUrl || LINKEDIN_URL;
---

<section id="hero" class="border-b border-border py-8 sm:py-10 md:py-20 lg:py-24 section-reveal">
	<div class="mx-auto max-w-6xl px-4 lg:px-8">
		<div class="grid gap-6 sm:gap-7 md:gap-10 lg:grid-cols-5 lg:gap-16">
			<!-- Left Column: Content Stack -->
			<div class="lg:col-span-3 flex flex-col">
				<!-- Logo -->
				<div class="fx-entrance mb-4 flex items-center gap-3 sm:mb-5 md:mb-8">
					<LogoMark size="md" />
					<span class="font-mono text-sm text-text-muted">carlosgb.dev</span>
				</div>

				<!-- Eyebrow / Status with subtle cursor -->
				{eyebrow && (
					<div class="fx-entrance fx-entrance-delay-1 mb-2 flex items-center gap-2 md:mb-3">
						<span class="relative flex h-2 w-2">
							<span class="absolute inline-flex h-full w-full animate-pulse rounded-full bg-signal opacity-75"></span>
							<span class="relative inline-flex h-2 w-2 rounded-full bg-signal"></span>
						</span>
						<span class="eyebrow-status font-mono text-sm uppercase tracking-wider text-text-muted">
							{eyebrow}
							<span class="eyebrow-status__cursor" aria-hidden="true"></span>
						</span>
					</div>
				)}

				<!-- Mobile Intro Row -->
				<div class="fx-entrance fx-entrance-delay-2 mb-3 flex items-center gap-3 md:hidden">
					<div class="min-w-0 flex-1">
						<h1 class="mb-1.5 text-[1.9rem] leading-[0.96] font-bold tracking-tight text-text-primary sm:text-[2.1rem]">
							{title}
						</h1>
						{tagline && (
							<p class="max-w-[18ch] text-sm font-medium leading-snug text-primary sm:text-[0.95rem]">
								{tagline}
							</p>
						)}
					</div>

					<div class="hero-portrait-panel hero-portrait-panel--compact shrink-0" aria-hidden="true">
						<span class="hero-portrait-panel__cut hero-portrait-panel__cut--top"></span>
						<span class="hero-portrait-panel__cut hero-portrait-panel__cut--bottom"></span>
						<div class="hero-portrait-panel__frame">
							<Image
								src={profileImage}
								alt=""
								class="hero-portrait-panel__image"
								width={220}
								height={300}
								loading="eager"
								decoding="async"
							/>
						</div>
					</div>
				</div>

				<!-- Title -->
				<h1 class="fx-entrance fx-entrance-delay-2 mb-2 hidden text-4xl font-bold tracking-tight text-text-primary md:block md:text-5xl lg:text-6xl">
					{title}
				</h1>

				<!-- Tagline -->
				{tagline && (
					<p class="fx-entrance fx-entrance-delay-3 mb-3 hidden text-lg font-medium text-primary md:mb-4 md:block md:text-2xl">
						{tagline}
					</p>
				)}

				<!-- Description -->
				{description && (
					<p class="fx-entrance fx-entrance-delay-4 mb-4 max-w-prose text-[0.95rem] leading-relaxed tracking-wide text-text-secondary sm:text-lg md:mb-6 md:text-xl md:leading-relaxed">
						{description}
					</p>
				)}

				<!-- Content Body (Markdown) -->
				<div class="fx-entrance fx-entrance-delay-5 mb-5 prose prose-invert prose-sm max-w-none text-text-secondary md:mb-8">
					<Content />
				</div>

				<!-- Proof Signals -->
				{proofSignals && proofSignals.length > 0 && (
					<div class="fx-entrance fx-entrance-delay-5 mb-5 grid grid-cols-3 gap-3 border-l-2 border-border pl-3 md:mb-8 md:flex md:flex-wrap md:gap-6 md:pl-4">
						{proofSignals.map((signal) => (
							<div class="flex min-w-0 flex-col fx-hover-lift">
								<span class="font-mono text-xl font-bold text-text-primary md:text-2xl">
									{signal.value}
								</span>
								<span class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-text-muted md:text-xs md:tracking-wider">
									{signal.label}
								</span>
							</div>
						))}
					</div>
				)}

				<!-- CTA Row -->
				<div class="fx-entrance fx-entrance-delay-5 flex flex-col gap-2.5 md:flex-row md:flex-wrap md:gap-3">
					<a
						href={linkedInHref}
						target="_blank"
						rel="noopener noreferrer"
						class="fx-hover-lift inline-flex w-full items-center justify-center gap-2.5 rounded-lg bg-primary px-4 py-3 text-center text-sm font-medium text-text-primary transition-colors hover:bg-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background md:w-auto md:gap-3 md:px-6 md:text-base"
					>
						<svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
						</svg>
						<span>Contact Me</span>
					</a>
					<a
						href={resumeUrl && resumeUrl !== '#' ? resumeUrl : resumeFile}
						download="Carlos-Engel-Olivo-CV.pdf"
						class="fx-hover-border inline-flex w-full items-center justify-center gap-2.5 rounded-lg border border-border-strong bg-surface-elevated px-4 py-3 text-center text-sm font-medium text-text-secondary transition-colors hover:border-border hover:text-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background md:w-auto md:px-6 md:py-3.5 md:text-base"
					>
						<svg class="h-4.5 w-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
						</svg>
						<span>Download CV</span>
					</a>
				</div>
			</div>

			<!-- Right Column: Visual Area -->
			<div class="fx-reveal-scale hidden -mt-1 md:flex lg:col-span-2 items-start justify-center lg:mt-0 lg:items-center lg:justify-end lg:pl-8">
				<div class="relative overflow-hidden">
					<!-- Profile Photo Area -->
					<div class="relative z-10 flex items-center justify-center">
						<div class="hero-portrait-panel hero-portrait-panel--desktop">
							<span class="hero-portrait-panel__cut hero-portrait-panel__cut--top"></span>
							<span class="hero-portrait-panel__cut hero-portrait-panel__cut--bottom"></span>
							<div class="hero-portrait-panel__frame">
								<Image
									src={profileImage}
									alt={title}
									class="hero-portrait-panel__image"
									width={420}
									height={540}
									loading="eager"
									decoding="async"
								/>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-portrait-panel {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem;
		border-radius: 1.8rem 2.35rem 1.3rem 2.5rem;
		background: linear-gradient(180deg, rgb(32 37 48 / 0.92), rgb(19 22 28 / 0.98));
		border: 1px solid rgb(56 66 86 / 0.7);
		box-shadow:
			0 1px 0 rgb(255 255 255 / 0.04) inset,
			0 22px 54px rgb(0 0 0 / 0.28);
		isolation: isolate;
		overflow: hidden;
		clip-path: polygon(0 10%, 14% 0, 100% 0, 100% 76%, 90% 100%, 18% 100%, 0 88%);
	}

	.hero-portrait-panel--compact {
		width: 5.1rem;
		aspect-ratio: 0.68;
		padding: 0.3rem;
		border-radius: 1.15rem 1.6rem 0.95rem 1.75rem;
	}

	.hero-portrait-panel--desktop {
		width: min(22rem, 30vw);
		aspect-ratio: 0.78;
	}

	.hero-portrait-panel::before {
		content: '';
		position: absolute;
		inset: 0.5rem;
		border-radius: inherit;
		background: linear-gradient(145deg, rgb(255 255 255 / 0.05), transparent 34%, transparent 66%, rgb(32 137 159 / 0.06));
		filter: blur(16px);
		z-index: -2;
	}

	.hero-portrait-panel::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background:
			linear-gradient(180deg, rgb(255 255 255 / 0.03), transparent 18%),
			radial-gradient(circle at 20% 18%, rgb(255 255 255 / 0.08), transparent 22%),
			linear-gradient(135deg, transparent 0 64%, rgb(32 137 159 / 0.08) 64% 66%, transparent 66% 100%);
		z-index: -1;
	}

	.hero-portrait-panel__cut {
		position: absolute;
		background: var(--color-background);
		pointer-events: none;
		z-index: 3;
	}

	.hero-portrait-panel__cut--top {
		top: -0.1rem;
		left: -0.1rem;
		width: 1.9rem;
		height: 1.55rem;
		clip-path: polygon(0 0, 100% 0, 0 100%);
		opacity: 0.92;
	}

	.hero-portrait-panel__cut--bottom {
		right: -0.1rem;
		bottom: -0.1rem;
		width: 2.35rem;
		height: 2rem;
		clip-path: polygon(100% 0, 100% 100%, 0 100%);
		opacity: 0.96;
	}

	.hero-portrait-panel__frame {
		position: relative;
		width: 100%;
		height: 100%;
		min-height: 100%;
		overflow: hidden;
		border-radius: 1.25rem 1.7rem 1rem 1.9rem;
		background: rgb(15 18 24 / 0.9);
		border: 1px solid rgb(126 135 152 / 0.14);
		box-shadow:
			0 0 0 1px rgb(126 135 152 / 0.08),
			0 16px 32px rgb(0 0 0 / 0.18);
		clip-path: polygon(0 10%, 13% 0, 100% 0, 100% 76%, 90% 100%, 18% 100%, 0 88%);
	}

	.hero-portrait-panel__frame::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgb(16 18 20 / 0.08), transparent 18%, transparent 78%, rgb(16 18 20 / 0.24)),
			radial-gradient(circle at 0% 0%, rgb(16 18 20 / 0.2), transparent 24%),
			radial-gradient(circle at 100% 100%, rgb(16 18 20 / 0.22), transparent 28%);
		pointer-events: none;
		z-index: 2;
	}

	.hero-portrait-panel__frame::after {
		content: '';
		position: absolute;
		inset: 0;
		box-shadow:
			inset 0 0 0 1px rgb(255 255 255 / 0.04),
			inset 0 0 28px rgb(16 18 20 / 0.14),
			inset 0 0 72px rgb(16 18 20 / 0.24);
		pointer-events: none;
		z-index: 3;
	}

	.hero-portrait-panel__image {
		height: 100%;
		width: 100%;
		object-fit: cover;
		object-position: center 22%;
		transform: scale(1.035);
		filter: saturate(0.94) contrast(1.03);
	}

	@media (min-width: 48rem) {
		.hero-portrait-panel {
			padding: 0.85rem;
		}

		.hero-portrait-panel--compact {
			width: 7.5rem;
			aspect-ratio: 0.72;
			padding: 0.45rem;
		}

		.hero-portrait-panel__frame {
			border-radius: 1.45rem 1.95rem 1.15rem 2.1rem;
		}

		.hero-portrait-panel__cut--top {
			width: 3.1rem;
			height: 2.6rem;
		}

		.hero-portrait-panel__cut--bottom {
			width: 3.7rem;
			height: 3.2rem;
		}
	}
</style>
