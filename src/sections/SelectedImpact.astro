---
import { getCollection } from 'astro:content';

const impactEntries = await getCollection('selectedImpact');
const impacts = impactEntries.sort((a, b) => a.data.order - b.data.order);
---

<section id="selected-impact" class="border-b border-border bg-surface py-16 section-reveal">
	<div class="mx-auto max-w-6xl px-4">
		<h2 class="fx-reveal mb-8 text-2xl font-bold tracking-tight text-text-primary md:text-3xl">
			Selected Impact
		</h2>
		<div class="grid gap-6 md:grid-cols-3 fx-stagger-group">
			{impacts.map((item) => (
				<article class="fx-reveal-up fx-hover-card rounded-lg border border-border bg-surface-elevated p-6">
					<div class="mb-3 font-mono text-3xl font-bold tracking-tight text-signal">
						{item.data.metric}
					</div>
					<h3 class="mb-2 text-lg font-semibold text-text-primary">
						{item.data.title}
					</h3>
					{item.data.description && (
						<p class="text-sm text-text-muted">
							{item.data.description}
						</p>
					)}
				</article>
			))}
		</div>
	</div>
</section>
