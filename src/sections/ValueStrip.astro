---
// ValueStrip — Core capability areas for quick scanning
const values = [
	{ label: 'Scalable APIs', description: 'REST and GraphQL backends built for multi-tenant SaaS, travel platforms, and high-throughput workloads.' },
	{ label: 'Event-Driven Systems', description: 'SNS, EventBridge, background workers, and real-time pipelines that keep services decoupled and responsive.' },
	{ label: 'Provider Integrations', description: 'Hotel connectivity, rate synchronization, and quoting flows across 8+ travel inventory providers.' },
	{ label: 'Cloud Automation', description: 'AWS deployments, CI/CD, and performance tuning that cut cold starts, reduce toil, and improve reliability.' },
];
---

<section id="value-strip" class="border-b border-border bg-surface-alt py-10 section-reveal md:py-14">
	<div class="mx-auto max-w-6xl px-4">
		<p class="mb-6 font-mono text-xs uppercase tracking-[0.22em] text-text-muted md:mb-8">
			What I deliver
		</p>
		<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4 fx-stagger-group">
			{values.map((item) => (
				<div class="fx-reveal-up flex flex-col gap-2 rounded-lg border border-border bg-surface px-4 py-5 transition-colors hover:border-border-strong hover:bg-surface-elevated">
					<span class="text-base font-bold tracking-tight text-text-primary md:text-lg">
						{item.label}
					</span>
					<span class="text-sm leading-relaxed text-text-secondary">
						{item.description}
					</span>
				</div>
			))}
		</div>
	</div>
</section>
