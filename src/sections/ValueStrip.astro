---
// ValueStrip — Core capability areas for quick scanning
const values = [
	{ label: 'Product Infrastructure', description: 'Backend foundations for multi-tenant products, operational workflows, and high-volume user activity.' },
	{ label: 'Workflow Automation', description: 'Systems that remove manual steps, connect services, and keep business processes moving reliably.' },
	{ label: 'External Integrations', description: 'Provider and platform connections that normalize data, handle edge cases, and support dependable operations.' },
	{ label: 'Reliability Improvements', description: 'Performance, deployment, and monitoring work that reduces toil and keeps production systems stable.' },
];
interface Props {
	locale?: 'en' | 'es';
}
const { locale = 'en' } = Astro.props;
const sectionLabel = locale === 'es' ? 'Lo que entrego' : 'What I deliver';
const localizedValues = locale === 'es'
	? [
			{ label: 'Infraestructura de producto', description: 'Bases backend para productos multi-tenant, flujos operativos y actividad de usuarios de alto volumen.' },
			{ label: 'Automatización de workflows', description: 'Sistemas que eliminan pasos manuales, conectan servicios y mantienen procesos de negocio funcionando con confiabilidad.' },
			{ label: 'Integraciones externas', description: 'Conexiones con proveedores y plataformas que normalizan datos, manejan casos borde y sostienen operaciones confiables.' },
			{ label: 'Mejoras de confiabilidad', description: 'Trabajo de rendimiento, despliegue y monitoreo que reduce esfuerzo operativo y mantiene estable producción.' },
		]
	: values;
---

<section id="value-strip" class="value-strip border-b border-border bg-surface-container-low py-10 md:py-14" data-reveal>
	<div class="mx-auto max-w-6xl px-4">
		<p class="value-strip__label mb-6 font-mono text-xs uppercase tracking-[0.22em] text-text-muted md:mb-8" data-reveal-item data-i18n="value.label">
			{sectionLabel}
		</p>
		<ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4" role="list">
			{localizedValues.map((item, index) => (
				<li class="value-card flex flex-col gap-2 rounded-lg border border-border bg-surface-container-lowest px-4 py-5 transition-colors hover:border-border-strong hover:bg-surface-container" data-reveal-item style={`--reveal-delay: ${(index + 1) * 70}ms;`}>
					<span class="text-base font-normal tracking-tight text-text-primary md:text-lg" data-i18n={`value.${index}.title`}>
						{item.label}
					</span>
					<span class="text-sm leading-relaxed text-text-secondary" data-i18n={`value.${index}.description`}>
						{item.description}
					</span>
				</li>
			))}
		</ul>
	</div>
</section>
