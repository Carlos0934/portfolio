---
interface Props {
	size?: 'sm' | 'md' | 'lg';
	class?: string;
}

const { size = 'md', class: className } = Astro.props;

const sizeMap = {
	sm: '2rem',
	md: '2.5rem',
	lg: '3.75rem',
};

const container = sizeMap[size];
---

<div
	class:list={['logo-mark', className]}
	style={`--container: ${container};`}
	aria-label="Carlos Olivo logo"
>
	<svg
		viewBox="0 0 128 128"
		xmlns="http://www.w3.org/2000/svg"
		aria-hidden="true"
		class="logo-mark__svg"
		fill="none"
	>
		<rect width="128" height="128" rx="30" fill="var(--color-primary)" />
		<path d="M60.14 49.86A20 20 0 1 0 60.14 78.14" stroke="var(--color-on-primary)" stroke-width="13" stroke-linecap="round" />
		<circle cx="90" cy="64" r="16" stroke="var(--color-on-primary)" stroke-width="13" />
	</svg>
</div>

<style>
	.logo-mark {
		width: var(--container);
		height: var(--container);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		line-height: 0;
		transition: transform 220ms ease;
	}

	.logo-mark:hover {
		transform: translateY(-1px);
	}

	.logo-mark__svg {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
