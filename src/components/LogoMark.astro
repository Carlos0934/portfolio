---
interface Props {
	size?: 'sm' | 'md' | 'lg';
	variant?: 'inherit' | 'light' | 'dark';
	class?: string;
}

const { size = 'md', variant = 'inherit', class: className } = Astro.props;

const colorMap = {
	inherit: 'currentColor',
	light: '#ffffff',
	dark: '#000000',
} as const;

const sizeMap = {
	sm: { container: '2rem' },
	md: { container: '2.5rem' },
	lg: { container: '3.75rem' },
};

const { container } = sizeMap[size];
const logoInk = colorMap[variant];
---

<div
	class:list={['logo-mark', `logo-mark--${variant}`, className]}
	style={`--container: ${container}; --logo-ink: ${logoInk};`}
	aria-label="Carlos Olivo logo"
>
	<svg
		viewBox="0 0 128 128"
		xmlns="http://www.w3.org/2000/svg"
		aria-hidden="true"
		class="logo-mark__svg"
		fill="none"
	>
		<path
			d="M87 28H54C34.67 28 19 43.67 19 63V65C19 84.33 34.67 100 54 100H87"
			stroke="currentColor"
			stroke-width="13"
			stroke-linecap="square"
			stroke-linejoin="round"
		/>
		<circle cx="74" cy="64" r="20" stroke="currentColor" stroke-width="13" />
		<path d="M92 64H113" stroke="currentColor" stroke-width="13" stroke-linecap="square" />
	</svg>
</div>

<style>
	.logo-mark {
		width: var(--container);
		height: var(--container);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--logo-ink);
		flex-shrink: 0;
		line-height: 0;
		transition:
			color 180ms ease,
			transform 220ms ease;
	}

	.logo-mark--inherit {
		color: inherit;
	}

	.logo-mark--light {
		color: #ffffff;
	}

	.logo-mark--dark {
		color: #000000;
	}

	.logo-mark:hover {
		transform: translateY(-1px);
	}

	.logo-mark__svg {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
