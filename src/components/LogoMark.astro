<style>
	.logo-mark {
		width: var(--container);
		height: var(--container);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: inherit;
		flex-shrink: 0;
		line-height: 0;
		transition:
			color 180ms ease,
			transform 220ms ease;
	}

	.logo-mark--light {
		color: #ffffff;
	}

	.logo-mark--dark {
		color: #000000;
	}

	.logo-mark:hover {
		transform: translateY(-1px);
	}

	.logo-mark__svg {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
