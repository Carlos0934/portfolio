---
interface Props {
	size?: 'sm' | 'md' | 'lg';
	variant?: 'inherit' | 'light' | 'dark';
	class?: string;
}

const { size = 'md', variant = 'inherit', class: className } = Astro.props;
const filterId = `logo-cutout-${Math.random().toString(36).slice(2, 9)}`;

const colorMap = {
	inherit: 'currentColor',
	light: '#ffffff',
	dark: '#000000',
} as const;

const sizeMap = {
	sm: { container: '2rem' },
	md: { container: '2.5rem' },
	lg: { container: '3.75rem' },
};

const { container } = sizeMap[size];
const logoInk = colorMap[variant];
---

