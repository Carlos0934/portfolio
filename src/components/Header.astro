---
import { getCollection } from 'astro:content';
import { NAV_ITEMS } from '../lib/nav';
import { SITE_TITLE, LINKEDIN_URL, GITHUB_URL } from '../consts';
import LogoMark from './LogoMark.astro';

const mobileNavItems = NAV_ITEMS.slice(1);
const contactEntries = await getCollection('contact');
const heroEntries = await getCollection('hero');
const contact = contactEntries[0];
const hero = heroEntries[0];
const { linkedinUrl, githubUrl, email } = contact?.data ?? {};
const { resumeUrl } = hero?.data ?? {};
const linkedInHref = linkedinUrl || LINKEDIN_URL;
const githubHref = githubUrl || GITHUB_URL;
const localResumeHref = '/Carlos-Olivo-CV.pdf';
const resumeHref = resumeUrl && resumeUrl !== '#' ? resumeUrl : localResumeHref;
const externalLinks = [
	{ label: 'LinkedIn', href: linkedInHref },
	{ label: 'GitHub', href: githubHref },
];
---

<header class="site-header" data-scrolled="false">
	<div class="top-contact-bar">
		<div class="top-contact-bar__inner">
			<div class="top-contact-bar__actions">
				{email ? (
					<>
						<a href={`mailto:${email}`} class="top-contact-email">{email}</a>
						<button type="button" class="top-contact-chip top-contact-chip--ghost" data-copy-email data-email={email}>
							Copy
						</button>
					</>
				) : (
					<a href="#contact" class="top-contact-chip top-contact-chip--ghost">Contact</a>
				)}
				<a
					href={resumeHref}
					download="Carlos-Olivo-CV.pdf"
					class="top-contact-chip top-contact-chip--primary"
					data-resume-download
				>
					CV
				</a>
			</div>

			<div class="top-contact-bar__links" aria-label="External links">
				{externalLinks.map((link, index) => (
					<>
						{index > 0 && <span class="top-contact-bar__separator" aria-hidden="true">/</span>}
						<a href={link.href} target="_blank" rel="noopener noreferrer" class="top-contact-link">
							{link.label}
						</a>
					</>
				))}
			</div>
		</div>
	</div>

	<nav class="header-nav" aria-label="Main navigation">
		<a href="#hero" class="logo-link">
			<LogoMark size="sm" />
			<span class="logo-text">{SITE_TITLE}</span>
		</a>

		<button
			class="menu-button"
			id="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="mobile-drawer"
			aria-label="Open navigation menu"
		>
			<svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<line x1="3" y1="6" x2="21" y2="6"></line>
				<line x1="3" y1="12" x2="21" y2="12"></line>
				<line x1="3" y1="18" x2="21" y2="18"></line>
			</svg>
			<svg class="close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
	</nav>

	<div class="mobile-drawer" id="mobile-drawer" role="dialog" aria-modal="true" aria-label="Navigation menu" inert aria-hidden="true">
		<div class="drawer-content">
			<nav class="drawer-nav" aria-label="Navigation menu">
				<ul class="drawer-list" role="list">
					{mobileNavItems.map((item) => (
						<li>
							<a href={item.href} class="drawer-link" data-nav-link>
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		</div>
	</div>

	<div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 60;
		isolation: isolate;
		border-bottom: 1px solid transparent;
		background-color: rgb(16 18 20 / 0.82);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		transition:
			background-color var(--fx-duration-normal) var(--fx-easing-out),
			border-color var(--fx-duration-normal) var(--fx-easing-out),
			box-shadow var(--fx-duration-normal) var(--fx-easing-out);
	}

	.site-header[data-scrolled="true"] {
		border-bottom-color: rgb(56 66 86 / 0.82);
		background-color: rgb(26 30 38 / 0.95);
		box-shadow: 0 12px 28px rgb(0 0 0 / 0.18);
	}

	.top-contact-bar__inner,
	.header-nav {
		width: min(100%, 78rem);
		margin: 0 auto;
		padding-inline: 1rem;
	}

	.top-contact-bar {
		padding: 0.85rem 0;
		transition: padding var(--fx-duration-normal) var(--fx-easing-out);
	}

	.site-header[data-scrolled="true"] .top-contact-bar {
		padding: 0.62rem 0;
	}

	.top-contact-bar__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 1.25rem;
		flex-wrap: wrap;
	}

	.top-contact-bar__actions,
	.top-contact-bar__links {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.top-contact-email,
	.top-contact-link {
		text-decoration: none;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.02em;
		color: var(--color-text-secondary);
		transition: color var(--fx-duration-fast) ease;
	}

	.top-contact-email:hover,
	.top-contact-email:focus-visible,
	.top-contact-link:hover,
	.top-contact-link:focus-visible {
		color: var(--color-text-primary);
	}

	.top-contact-chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.5rem;
		padding: 0 1rem;
		border: 1px solid rgb(56 66 86 / 0.72);
		border-radius: 999px;
		background: rgb(28 31 37 / 0.72);
		color: var(--color-text-primary);
		font-family: var(--font-mono);
		font-size: 0.74rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
		cursor: pointer;
		transition:
			background-color var(--fx-duration-fast) ease,
			border-color var(--fx-duration-fast) ease,
			color var(--fx-duration-fast) ease,
			transform var(--fx-duration-fast) ease;
	}

	.top-contact-chip:hover,
	.top-contact-chip:focus-visible {
		border-color: var(--color-primary);
		color: var(--color-text-primary);
		transform: translateY(-1px);
	}

	.top-contact-chip--ghost {
		background: transparent;
		color: var(--color-text-secondary);
	}

	.top-contact-chip--primary {
		background: rgb(255 255 255 / 0.06);
	}

	.top-contact-bar__separator {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--color-text-muted);
	}

	.header-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 0;
		padding-bottom: 0.85rem;
		border-top: 1px solid rgb(42 49 64 / 0.45);
		transition:
			padding-bottom var(--fx-duration-normal) var(--fx-easing-out),
			border-top-color var(--fx-duration-normal) var(--fx-easing-out);
	}

	.site-header[data-scrolled="true"] .header-nav {
		padding-bottom: 0.62rem;
		border-top-color: rgb(56 66 86 / 0.72);
	}

	.logo-link {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		text-decoration: none;
		color: var(--color-text-primary);
		font-family: var(--font-mono);
		font-size: 0.875rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		transition: color var(--fx-duration-fast) ease;
	}

	.logo-link:hover,
	.logo-link:focus-visible {
		color: var(--color-primary);
	}

	.logo-link :global(.logo-mark) {
		transition: color var(--fx-duration-fast) ease;
	}

	.logo-text {
		display: none;
	}

	.menu-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		color: var(--color-text-secondary);
		cursor: pointer;
		transition: all var(--fx-duration-fast) ease;
	}

	.menu-button:hover {
		border-color: var(--color-primary);
		color: var(--color-text-primary);
	}

	.menu-button:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
	}

	.menu-button[aria-expanded="true"] {
		border-color: var(--color-primary);
		color: var(--color-primary);
	}

	.menu-icon,
	.close-icon {
		width: 1.25rem;
		height: 1.25rem;
	}

	.mobile-drawer {
		position: fixed;
		top: 0;
		right: 0;
		width: 280px;
		max-width: 85vw;
		height: 100vh;
		background: var(--color-surface);
		border-left: 1px solid var(--color-border);
		transform: translateX(100%);
		transition: transform 0.25s ease;
		overflow-y: auto;
		z-index: 100;
	}

	.mobile-drawer[data-open="true"] {
		transform: translateX(0);
	}

	.drawer-content {
		padding: var(--spacing-16) var(--spacing-6);
	}

	.drawer-nav {
		display: flex;
		flex-direction: column;
	}

	.drawer-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
	}

	.drawer-link {
		display: block;
		padding: var(--spacing-3) var(--spacing-4);
		text-decoration: none;
		color: var(--color-text-secondary);
		font-family: var(--font-sans);
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		border-radius: var(--radius-sm);
		transition: all 0.15s ease;
	}

	.drawer-link:hover {
		background: var(--color-surface-elevated);
		color: var(--color-text-primary);
		border-left: 2px solid var(--color-primary);
		padding-left: calc(var(--spacing-4) - 2px);
	}

	.drawer-link:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: -2px;
	}

	.drawer-link.active {
		background: var(--color-surface-elevated);
		color: var(--color-primary);
		border-left: 3px solid var(--color-primary);
		padding-left: calc(var(--spacing-4) - 3px);
	}

	.drawer-backdrop {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgb(16 18 20 / 0.8);
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.25s ease, visibility 0.25s ease;
		z-index: 90;
	}

	.drawer-backdrop[data-visible="true"] {
		opacity: 1;
		visibility: visible;
	}

	@media (min-width: 480px) {
		.logo-text {
			display: inline;
		}
	}

	@media (max-width: 767px) {
		.top-contact-bar__inner {
			align-items: flex-start;
		}

		.top-contact-bar__links {
			gap: 0.5rem;
		}
	}

	@media (min-width: 1280px) {
		.header-nav {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.top-contact-email,
		.top-contact-link,
		.top-contact-chip,
		.mobile-drawer,
		.drawer-backdrop,
		.drawer-link {
			transition: none;
		}
	}
</style>

<script>
	class MobileDrawer {
		drawer: HTMLElement | null;
		backdrop: HTMLElement | null;
		toggleBtn: HTMLButtonElement | null;
		drawerLinks: NodeListOf<HTMLAnchorElement>;
		isOpen: boolean;
		previousActiveElement: Element | null;

		constructor() {
			this.drawer = document.getElementById('mobile-drawer');
			this.backdrop = document.getElementById('drawer-backdrop');
			this.toggleBtn = document.getElementById('menu-toggle') as HTMLButtonElement | null;
			this.drawerLinks = document.querySelectorAll('[data-nav-link]');
			this.isOpen = false;
			this.previousActiveElement = null;

			if (!this.drawer || !this.toggleBtn || !this.backdrop) return;

			this.init();
		}

		init() {
			this.toggleBtn?.addEventListener('click', () => this.toggle());
			this.backdrop?.addEventListener('click', () => this.close());

			this.drawerLinks.forEach((link) => {
				link.addEventListener('click', () => this.close());
			});

			document.addEventListener('keydown', (e: KeyboardEvent) => {
				if (e.key === 'Escape' && this.isOpen) {
					this.close();
				}
			});

			this.drawer?.addEventListener('keydown', (e: KeyboardEvent) => {
				if (e.key === 'Tab' && this.isOpen) {
					this.trapFocus(e);
				}
			});
		}

		toggle() {
			this.isOpen ? this.close() : this.open();
		}

		open() {
			if (!this.drawer || !this.toggleBtn || !this.backdrop) return;

			this.isOpen = true;
			this.previousActiveElement = document.activeElement;

			this.drawer.removeAttribute('inert');
			this.drawer.removeAttribute('aria-hidden');
			this.toggleBtn.setAttribute('aria-expanded', 'true');
			this.toggleBtn.setAttribute('aria-label', 'Close navigation menu');
			this.drawer.setAttribute('data-open', 'true');
			this.backdrop.setAttribute('data-visible', 'true');
			document.body.style.overflow = 'hidden';

			window.setTimeout(() => {
				const firstLink = this.drawer?.querySelector('a');
				if (firstLink instanceof HTMLElement) firstLink.focus();
			}, 100);
		}

		close() {
			if (!this.drawer || !this.toggleBtn || !this.backdrop) return;

			this.isOpen = false;
			this.toggleBtn.setAttribute('aria-expanded', 'false');
			this.toggleBtn.setAttribute('aria-label', 'Open navigation menu');
			this.drawer.setAttribute('data-open', 'false');
			this.backdrop.setAttribute('data-visible', 'false');
			document.body.style.overflow = '';

			window.setTimeout(() => {
				this.drawer?.setAttribute('inert', '');
				this.drawer?.setAttribute('aria-hidden', 'true');
			}, 250);

			if (this.previousActiveElement instanceof HTMLElement) {
				this.previousActiveElement.focus();
			}
		}

		trapFocus(e: KeyboardEvent) {
			if (!this.drawer) return;

			const focusableElements = this.drawer.querySelectorAll<HTMLElement>('a, button');
			const firstElement = focusableElements[0];
			const lastElement = focusableElements[focusableElements.length - 1];

			if (!firstElement || !lastElement) return;

			if (e.shiftKey) {
				if (document.activeElement === firstElement) {
					e.preventDefault();
					lastElement.focus();
				}
			} else if (document.activeElement === lastElement) {
				e.preventDefault();
				firstElement.focus();
			}
		}
	}

	class HeaderState {
		header: HTMLElement | null;
		hero: HTMLElement | null;

		constructor() {
			this.header = document.querySelector('.site-header');
			this.hero = document.getElementById('hero');

			if (!this.header) return;

			const header = this.header;
			const hero = this.hero;

			if (!hero || !('IntersectionObserver' in window)) {
				header.setAttribute('data-scrolled', 'true');
				return;
			}

			const observer = new IntersectionObserver(
				(entries) => {
					const [entry] = entries;
					const isNearTop = entry.isIntersecting && entry.intersectionRatio > 0.2;
					header.setAttribute('data-scrolled', isNearTop ? 'false' : 'true');
				},
				{
					threshold: [0, 0.2, 0.6],
					rootMargin: '-72px 0px 0px 0px',
				}
			);

			observer.observe(hero);
		}
	}

	class EmailCopyButton {
		button: HTMLButtonElement | null;

		constructor() {
			this.button = document.querySelector('[data-copy-email]');
			if (!this.button) return;

			const button = this.button as HTMLButtonElement;

			button.addEventListener('click', async () => {
				const email = button.dataset.email;
				if (!email || !navigator.clipboard) return;

				await navigator.clipboard.writeText(email);
				const originalLabel = button.textContent;
				button.textContent = 'Copied';
				window.setTimeout(() => {
					button.textContent = originalLabel;
				}, 1400);
			});
		}
	}

	class ResumeDownloadLink {
		link: HTMLAnchorElement | null;

		constructor() {
			this.link = document.querySelector('[data-resume-download]');
			if (!this.link) return;

			this.link.addEventListener('click', (event) => this.handleClick(event));
		}

		async handleClick(event: MouseEvent) {
			const link = this.link;
			if (!link) return;

			const href = link.href;
			if (!href) return;

			const url = new URL(href, window.location.href);
			if (url.origin !== window.location.origin) return;

			event.preventDefault();

			try {
				const response = await fetch(url.toString());
				if (!response.ok) {
					window.location.href = url.toString();
					return;
				}

				const blob = await response.blob();
				const objectUrl = URL.createObjectURL(blob);
				const downloadLink = document.createElement('a');
				downloadLink.href = objectUrl;
				downloadLink.download = link.download || 'Carlos-Olivo-CV.pdf';
				document.body.append(downloadLink);
				downloadLink.click();
				downloadLink.remove();
				window.setTimeout(() => URL.revokeObjectURL(objectUrl), 0);
			} catch {
				window.location.href = url.toString();
			}
		}
	}

	document.addEventListener('DOMContentLoaded', () => {
		new HeaderState();
		new MobileDrawer();
		new EmailCopyButton();
		new ResumeDownloadLink();
	});
</script>
