---
import { NAV_ITEMS } from '../lib/nav';
import { SITE_TITLE } from '../consts';
import { useTranslations } from '../lib/i18n';
import LogoMark from './LogoMark.astro';

interface Props {
	lang?: string;
}

const { lang = 'en' } = Astro.props;
const isSpanish = lang === 'es';
const t = useTranslations(isSpanish ? 'es' : 'en');
const homeHref = isSpanish ? '/es/' : '/';
const cvPageHref = isSpanish ? '/es/cv/' : '/cv/';
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isHomePage = currentPath === homeHref;
const isCvPage = currentPath === cvPageHref;
const languageHref = isCvPage ? (isSpanish ? '/cv/' : '/es/cv/') : isSpanish ? '/' : '/es/';
const getSectionHref = (href: string) => (isHomePage ? href : `${homeHref}${href}`);
const navItems = NAV_ITEMS.map((item) => ({ ...item, href: getSectionHref(item.href), text: t(`nav.${item.id}`, item.label) }));
---

<header class="site-header" data-scrolled="false">
	<nav class="header-bar" aria-label="Main navigation">
		<a href={isHomePage ? '#hero' : homeHref} class="logo-link">
			<LogoMark size="sm" />
			<span class="logo-text">{SITE_TITLE}</span>
		</a>

		<ul class="header-links" role="list">
			{navItems.map((item) => (
				<li>
					<a href={item.href} class="header-link" data-i18n={`nav.${item.id}`}>{item.text}</a>
				</li>
			))}
		</ul>

		<div class="header-actions">
			{!isCvPage && <a href={cvPageHref} class="header-chip">CV</a>}
			<a href={languageHref} class="header-chip header-chip--ghost" hreflang={isSpanish ? 'en' : 'es'} lang={isSpanish ? 'en' : 'es'}>
				{isSpanish ? 'EN' : 'ES'}
			</a>
			<button type="button" class="icon-button" data-theme-toggle aria-label={isSpanish ? 'Cambiar tema' : 'Toggle color theme'}>
				<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
				</svg>
				<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
				</svg>
			</button>
			<button
				class="icon-button menu-button"
				id="menu-toggle"
				type="button"
				aria-expanded="false"
				aria-controls="mobile-drawer"
				aria-label={isSpanish ? 'Abrir menú' : 'Open navigation menu'}
			>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16" />
				</svg>
			</button>
		</div>
	</nav>

	<div class="mobile-drawer" id="mobile-drawer" role="dialog" aria-modal="true" aria-label={isSpanish ? 'Menú' : 'Navigation menu'} inert aria-hidden="true">
		<div class="drawer-header">
			<span class="drawer-title">{isSpanish ? 'Navegación' : 'Navigation'}</span>
			<button type="button" class="icon-button" data-drawer-close aria-label={isSpanish ? 'Cerrar menú' : 'Close navigation menu'}>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M18 6 6 18M6 6l12 12" />
				</svg>
			</button>
		</div>
		<ul class="drawer-list" role="list">
			{navItems.map((item) => (
				<li>
					<a href={item.href} class="drawer-link" data-nav-link data-i18n={`nav.${item.id}`}>{item.text}</a>
				</li>
			))}
			{!isCvPage && (
				<li>
					<a href={cvPageHref} class="drawer-link" data-nav-link>CV</a>
				</li>
			)}
		</ul>
	</div>

	<div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 60;
		border-bottom: 1px solid transparent;
		background-color: color-mix(in srgb, var(--color-background) 82%, transparent);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		transition:
			background-color var(--fx-duration-normal) var(--fx-easing-out),
			border-color var(--fx-duration-normal) var(--fx-easing-out);
	}

	.site-header[data-scrolled="true"] {
		border-bottom-color: var(--color-border);
		background-color: color-mix(in srgb, var(--color-background) 94%, transparent);
	}

	.header-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		width: min(100%, 72rem);
		height: 4.25rem;
		margin: 0 auto;
		padding-inline: 1rem;
	}

	.logo-link {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--color-text-primary);
		font-size: 0.98rem;
		font-weight: 500;
		text-decoration: none;
	}

	.logo-text {
		display: none;
	}

	.header-links {
		display: none;
		align-items: center;
		gap: 1.75rem;
		margin: 0 0 0 auto;
		padding: 0;
		list-style: none;
	}

	.header-link {
		color: var(--color-text-secondary);
		font-size: 0.92rem;
		text-decoration: none;
		transition: color var(--fx-duration-fast) ease;
	}

	.header-link:hover,
	.header-link:focus-visible {
		color: var(--color-text-primary);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.header-chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2.5rem;
		height: 2.375rem;
		padding: 0 0.85rem;
		border-radius: 10px;
		background: var(--color-button);
		color: var(--color-on-button);
		font-size: 0.85rem;
		font-weight: 500;
		text-decoration: none;
		transition: background-color var(--fx-duration-fast) ease;
	}

	.header-chip:hover,
	.header-chip:focus-visible {
		background: var(--color-button-hover);
	}

	.header-chip--ghost {
		border: 1px solid var(--color-border);
		background: var(--color-surface-container-lowest);
		color: var(--color-text-primary);
	}

	.header-chip--ghost:hover,
	.header-chip--ghost:focus-visible {
		border-color: var(--color-primary);
		background: var(--color-surface-container-lowest);
	}

	.icon-button {
		display: inline-grid;
		place-items: center;
		width: 2.375rem;
		height: 2.375rem;
		padding: 0;
		border: 1px solid var(--color-border);
		border-radius: 10px;
		background: var(--color-surface-container-lowest);
		color: var(--color-text-primary);
		cursor: pointer;
		transition: border-color var(--fx-duration-fast) ease;
	}

	.icon-button:hover,
	.icon-button:focus-visible {
		border-color: var(--color-primary);
	}

	.icon-button svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	/* Show the icon of the theme you would switch to */
	.icon-sun,
	:global([data-theme="dark"]) .icon-moon {
		display: none;
	}

	:global([data-theme="dark"]) .icon-sun {
		display: block;
	}

	.mobile-drawer {
		position: fixed;
		top: 0;
		right: 0;
		width: min(22rem, 100vw);
		height: 100dvh;
		padding: 1.25rem;
		background: var(--color-surface-container-lowest);
		border-left: 1px solid var(--color-border);
		transform: translateX(100%);
		transition: transform var(--fx-duration-normal) var(--fx-easing-out);
		overflow-y: auto;
		z-index: 100;
	}

	.mobile-drawer[data-open="true"] {
		transform: translateX(0);
	}

	.drawer-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 1rem;
		margin-bottom: 1rem;
		border-bottom: 1px solid var(--color-border);
	}

	.drawer-title {
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.drawer-list {
		display: grid;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.drawer-link {
		display: flex;
		align-items: center;
		min-height: 3rem;
		padding: 0 0.85rem;
		border-radius: 10px;
		color: var(--color-text-secondary);
		font-size: 1.05rem;
		text-decoration: none;
	}

	.drawer-link:hover,
	.drawer-link:focus-visible {
		background: var(--color-surface-container);
		color: var(--color-text-primary);
	}

	.drawer-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.35);
		opacity: 0;
		visibility: hidden;
		transition:
			opacity var(--fx-duration-normal) var(--fx-easing-out),
			visibility var(--fx-duration-normal) var(--fx-easing-out);
		z-index: 90;
	}

	.drawer-backdrop[data-visible="true"] {
		opacity: 1;
		visibility: visible;
	}

	@media (min-width: 64rem) {
		.header-bar {
			padding-inline: 2rem;
		}
	}

	@media (min-width: 480px) {
		.logo-text {
			display: inline;
		}
	}

	@media (min-width: 900px) {
		.header-links {
			display: flex;
		}

		.menu-button {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.mobile-drawer,
		.drawer-backdrop {
			transition: none;
		}
	}
</style>

<script>
	class MobileDrawer {
		drawer = document.getElementById('mobile-drawer');
		backdrop = document.getElementById('drawer-backdrop');
		toggleBtn = document.getElementById('menu-toggle') as HTMLButtonElement | null;
		isOpen = false;
		previousActiveElement: Element | null = null;

		constructor() {
			if (!this.drawer || !this.toggleBtn || !this.backdrop) return;

			this.toggleBtn.addEventListener('click', () => (this.isOpen ? this.close() : this.open()));
			this.backdrop.addEventListener('click', () => this.close());
			document.querySelectorAll('[data-drawer-close], [data-nav-link]').forEach((element) => {
				element.addEventListener('click', () => this.close());
			});
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && this.isOpen) this.close();
			});
			this.drawer.addEventListener('keydown', (event) => {
				if (event.key === 'Tab' && this.isOpen) this.trapFocus(event);
			});
		}

		open() {
			if (!this.drawer || !this.toggleBtn || !this.backdrop) return;

			this.isOpen = true;
			this.previousActiveElement = document.activeElement;
			this.drawer.removeAttribute('inert');
			this.drawer.removeAttribute('aria-hidden');
			this.toggleBtn.setAttribute('aria-expanded', 'true');
			this.drawer.setAttribute('data-open', 'true');
			this.backdrop.setAttribute('data-visible', 'true');
			document.body.style.overflow = 'hidden';

			window.setTimeout(() => this.drawer?.querySelector<HTMLElement>('a')?.focus(), 100);
		}

		close() {
			if (!this.drawer || !this.toggleBtn || !this.backdrop) return;

			this.isOpen = false;
			this.toggleBtn.setAttribute('aria-expanded', 'false');
			this.drawer.setAttribute('data-open', 'false');
			this.backdrop.setAttribute('data-visible', 'false');
			document.body.style.overflow = '';

			window.setTimeout(() => {
				this.drawer?.setAttribute('inert', '');
				this.drawer?.setAttribute('aria-hidden', 'true');
			}, 250);

			if (this.previousActiveElement instanceof HTMLElement) this.previousActiveElement.focus();
		}

		trapFocus(event: KeyboardEvent) {
			const focusable = this.drawer?.querySelectorAll<HTMLElement>('a, button');
			if (!focusable?.length) return;

			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first.focus();
			}
		}
	}

	function initHeaderState() {
		const header = document.querySelector('.site-header');
		if (!header) return;

		const update = () => header.setAttribute('data-scrolled', window.scrollY > 8 ? 'true' : 'false');
		update();
		window.addEventListener('scroll', update, { passive: true });
	}

	function initThemeToggle() {
		document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
			button.addEventListener('click', () => {
				const root = document.documentElement;
				const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
				root.dataset.theme = next;
				try {
					localStorage.setItem('theme', next);
				} catch {}
			});
		});
	}

	initHeaderState();
	initThemeToggle();
	new MobileDrawer();
</script>
