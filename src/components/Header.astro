---
import { NAV_ITEMS } from '../lib/nav';
import { SITE_TITLE } from '../consts';
import LogoMark from './LogoMark.astro';

// Mobile nav excludes hero (landing section)
const mobileNavItems = NAV_ITEMS.slice(1);
---

<header class="mobile-header">
	<nav class="header-nav" aria-label="Main navigation">
		<!-- Logo -->
		<a href="#hero" class="logo-link">
			<LogoMark size="sm" />
			<span class="logo-text">{SITE_TITLE}</span>
		</a>
		
		<!-- Mobile Menu Button -->
		<button
			class="menu-button"
			id="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="mobile-drawer"
			aria-label="Open navigation menu"
		>
			<svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<line x1="3" y1="6" x2="21" y2="6"></line>
				<line x1="3" y1="12" x2="21" y2="12"></line>
				<line x1="3" y1="18" x2="21" y2="18"></line>
			</svg>
			<svg class="close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
	</nav>
	
	<!-- Mobile Drawer -->
	<div class="mobile-drawer" id="mobile-drawer" role="dialog" aria-modal="true" aria-label="Navigation menu" inert aria-hidden="true">
		<div class="drawer-content">
			<nav class="drawer-nav" aria-label="Navigation menu">
				<ul class="drawer-list" role="list">
					{mobileNavItems.map((item) => (
						<li>
							<a href={item.href} class="drawer-link" data-nav-link>
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		</div>
	</div>
	
	<!-- Backdrop overlay -->
	<div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>
</header>

<style>
	.mobile-header {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 1px solid var(--color-border);
		background: rgba(26, 30, 38, 0.95);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}
	
	.header-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: var(--spacing-4);
		max-width: 640px;
		margin: 0 auto;
	}
	
	.logo-link {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		text-decoration: none;
		color: var(--color-text-primary);
		font-family: var(--font-mono);
		font-size: 0.875rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		transition: color 0.2s ease;
	}
	
	.logo-link:hover,
	.logo-link:focus-visible {
		color: var(--color-primary);
	}
	
	.logo-link :global(.logo-mark) {
		transition: color 0.2s ease;
	}
	
	.logo-text {
		display: none;
	}
	
	@media (min-width: 480px) {
		.logo-text {
			display: inline;
		}
	}
	
	/* Menu Button */
	.menu-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		color: var(--color-text-secondary);
		cursor: pointer;
		transition: all 0.2s ease;
	}
	
	.menu-button:hover {
		border-color: var(--color-primary);
		color: var(--color-text-primary);
	}
	
	.menu-button:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
	}
	
	.menu-button[aria-expanded="true"] {
		border-color: var(--color-primary);
		color: var(--color-primary);
	}
	
	.menu-icon,
	.close-icon {
		width: 1.25rem;
		height: 1.25rem;
	}
	
	/* Mobile Drawer */
	.mobile-drawer {
		position: fixed;
		top: 0;
		right: 0;
		width: 280px;
		max-width: 85vw;
		height: 100vh;
		background: var(--color-surface);
		border-left: 1px solid var(--color-border);
		transform: translateX(100%);
		transition: transform 0.25s ease;
		overflow-y: auto;
		z-index: 100;
	}
	
	.mobile-drawer[data-open="true"] {
		transform: translateX(0);
	}
	
	.drawer-content {
		padding: var(--spacing-16) var(--spacing-6);
	}
	
	.drawer-nav {
		display: flex;
		flex-direction: column;
	}
	
	.drawer-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
	}
	
	.drawer-link {
		display: block;
		padding: var(--spacing-3) var(--spacing-4);
		text-decoration: none;
		color: var(--color-text-secondary);
		font-family: var(--font-sans);
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		border-radius: var(--radius-sm);
		transition: all 0.15s ease;
	}
	
	.drawer-link:hover {
		background: var(--color-surface-elevated);
		color: var(--color-text-primary);
		border-left: 2px solid var(--color-primary);
		padding-left: calc(var(--spacing-4) - 2px);
	}
	
	.drawer-link:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: -2px;
	}
	
	.drawer-link.active {
		background: var(--color-surface-elevated);
		color: var(--color-primary);
		border-left: 3px solid var(--color-primary);
		padding-left: calc(var(--spacing-4) - 3px);
	}
	
	/* Backdrop */
	.drawer-backdrop {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(16, 18, 20, 0.8);
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.25s ease, visibility 0.25s ease;
		z-index: 90;
	}
	
	.drawer-backdrop[data-visible="true"] {
		opacity: 1;
		visibility: visible;
	}
	
	/* Hide on desktop (Progress Sidebar handles navigation) */
	@media (min-width: 1280px) {
		.mobile-header {
			display: none;
		}
	}
	
	/* Reduced motion */
	@media (prefers-reduced-motion: reduce) {
		.mobile-drawer,
		.drawer-backdrop {
			transition: none;
		}
		
		.drawer-link {
			transition: none;
		}
	}
</style>

<script>
	// Mobile Drawer Controller
	class MobileDrawer {
		constructor() {
			this.drawer = document.getElementById('mobile-drawer');
			this.backdrop = document.getElementById('drawer-backdrop');
			this.toggleBtn = document.getElementById('menu-toggle');
			this.drawerLinks = document.querySelectorAll('[data-nav-link]');
			this.isOpen = false;
			this.previousActiveElement = null;
			
			if (!this.drawer || !this.toggleBtn || !this.backdrop) return;
			
			this.init();
		}
		
		init() {
			// Toggle button
			this.toggleBtn.addEventListener('click', () => this.toggle());
			
			// Close on backdrop click
			this.backdrop.addEventListener('click', () => this.close());
			
			// Close on nav link click
			this.drawerLinks.forEach(link => {
				link.addEventListener('click', () => {
					this.close();
					// Smooth scroll is handled by native browser behavior
				});
			});
			
			// Close on Escape key
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && this.isOpen) {
					this.close();
				}
			});
			
			// Trap focus within drawer when open
			this.drawer.addEventListener('keydown', (e) => {
				if (e.key === 'Tab' && this.isOpen) {
					this.trapFocus(e);
				}
			});
		}
		
		toggle() {
			this.isOpen ? this.close() : this.open();
		}
		
		open() {
			this.isOpen = true;
			this.previousActiveElement = document.activeElement;
			
			// Remove inert and aria-hidden before opening
			this.drawer.removeAttribute('inert');
			this.drawer.removeAttribute('aria-hidden');
			
			// Update ARIA
			this.toggleBtn.setAttribute('aria-expanded', 'true');
			this.toggleBtn.setAttribute('aria-label', 'Close navigation menu');
			
			// Show drawer
			this.drawer.setAttribute('data-open', 'true');
			this.backdrop.setAttribute('data-visible', 'true');
			
			// Prevent body scroll
			document.body.style.overflow = 'hidden';
			
			// Focus first link
			setTimeout(() => {
				const firstLink = this.drawer.querySelector('a');
				if (firstLink) firstLink.focus();
			}, 100);
		}
		
		close() {
			this.isOpen = false;
			
			// Update ARIA
			this.toggleBtn.setAttribute('aria-expanded', 'false');
			this.toggleBtn.setAttribute('aria-label', 'Open navigation menu');
			
			// Hide drawer
			this.drawer.setAttribute('data-open', 'false');
			this.backdrop.setAttribute('data-visible', 'false');
			
			// Restore body scroll
			document.body.style.overflow = '';
			
			// Restore inert and aria-hidden after transition
			setTimeout(() => {
				this.drawer.setAttribute('inert', '');
				this.drawer.setAttribute('aria-hidden', 'true');
			}, 250);
			
			// Restore focus to toggle button
			if (this.previousActiveElement) {
				this.previousActiveElement.focus();
			}
		}
		
		trapFocus(e) {
			const focusableElements = this.drawer.querySelectorAll('a, button');
			const firstElement = focusableElements[0];
			const lastElement = focusableElements[focusableElements.length - 1];
			
			if (e.shiftKey) {
				// Shift + Tab
				if (document.activeElement === firstElement) {
					e.preventDefault();
					lastElement.focus();
				}
			} else {
				// Tab
				if (document.activeElement === lastElement) {
					e.preventDefault();
					firstElement.focus();
				}
			}
		}
	}
	
	// Initialize on DOM ready
	document.addEventListener('DOMContentLoaded', () => {
		new MobileDrawer();
	});
</script>