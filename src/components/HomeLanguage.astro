			'contact.location': 'Ubicación',
			'contact.profiles': 'Perfiles',
			'footer.rights': 'Todos los derechos reservados.',
		},
	};

	function pickLocale(): Locale {
		if (forcedLocale === 'es' || forcedLocale === 'en') return forcedLocale;
		const params = new URLSearchParams(window.location.search);
		const explicit = params.get('lang');
		if (explicit === 'es' || explicit === 'en') return explicit;
		return navigator.language.toLowerCase().startsWith('es') ? 'es' : 'en';
	}

	function applyLocale(locale: Locale) {
		const dictionary = translations[locale];
		document.documentElement.lang = locale;
		document.documentElement.dataset.locale = locale;

		document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((element) => {
			const key = element.dataset.i18n;
			if (!key) return;
			const value = dictionary[key];
			if (value) element.textContent = value;
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', () => applyLocale(pickLocale()), { once: true });
	} else {
		applyLocale(pickLocale());
	}
</script>
