---
import { es } from '../lib/i18n';

interface Props {
	locale?: 'auto' | 'en' | 'es';
}

const { locale = 'auto' } = Astro.props;
---

<!-- Plain JS: define:vars scripts are inlined without TypeScript processing. -->
<script define:vars={{ forcedLocale: locale, es }}>
	function pickLocale() {
		if (forcedLocale === 'es' || forcedLocale === 'en') return forcedLocale;
		const explicit = new URLSearchParams(window.location.search).get('lang');
		if (explicit === 'es' || explicit === 'en') return explicit;
		return navigator.language.toLowerCase().startsWith('es') ? 'es' : 'en';
	}

	function applyLocale(locale) {
		document.documentElement.lang = locale;
		document.documentElement.dataset.locale = locale;
		if (locale !== 'es') return;

		document.querySelectorAll('[data-i18n]').forEach((element) => {
			const value = es[element.dataset.i18n];
			if (!value) return;
			if (!element.hasAttribute('data-i18n-emphasis')) {
				element.textContent = value;
				return;
			}
			// Mirror Experience.astro: wrap numbers in <strong>.
			element.replaceChildren(
				...value.split(/(\d[\d.,]*%?)/).filter(Boolean).map((part) => {
					if (!/^\d/.test(part)) return document.createTextNode(part);
					const strong = document.createElement('strong');
					strong.textContent = part;
					return strong;
				})
			);
		});
		document.dispatchEvent(new CustomEvent('home:locale', { detail: locale }));
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', () => applyLocale(pickLocale()), { once: true });
	} else {
		applyLocale(pickLocale());
	}
</script>
